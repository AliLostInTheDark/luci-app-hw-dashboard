#!/bin/sh

. /usr/share/hwdash/rpcd-common.sh

WI_DIR=/tmp/hwdash_wanmon

# The collector's tracked list: the same set the WAN Uptime card shows, which
# also keeps modem-management interfaces off a card about internet links.
_wi_load_tracked() {
	_wi_ifaces=""
	[ -f "$WI_DIR/.tracked" ] || return
	while read -r _wif_l; do
		[ -n "$_wif_l" ] && _wi_ifaces="$_wi_ifaces $_wif_l"
	done < "$WI_DIR/.tracked"
}

_wi_parse_status() {
	_wup=""; _wproto=""; _wdev=""; _wpar=""; _wv4=""; _wm4=""
	_wv6_all=""; _wsnat=""; _wsnattgt=""; _p_addr=""; _p_mask=""
	_pa_addr=""; _pa_mask=""
	eval "$(printf '%s' "$1" | jsonfilter \
		-e '_wup=@.up' \
		-e '_wproto=@.proto' \
		-e '_wdev=@.l3_device' \
		-e '_wpar=@.device' \
		-e '_wv4=@["ipv4-address"][0].address' \
		-e '_wm4=@["ipv4-address"][0].mask' \
		-e '_wv6_all=@["ipv6-address"][*].address' \
		-e '_wsnat=@.data.firewall[0].snat_ip' \
		-e '_wsnattgt=@.data.firewall[0].target' \
		-e '_p_addr=@["ipv6-prefix"][0].address' \
		-e '_p_mask=@["ipv6-prefix"][0].mask' \
		-e '_pa_addr=@["ipv6-prefix-assignment"][0].address' \
		-e '_pa_mask=@["ipv6-prefix-assignment"][0].mask' 2>/dev/null)" 2>/dev/null
}

# First global IPv6 address in $1, else the first address of any kind.
_wi_pick_v6() {
	_wv6=""
	for _a6 in $1; do
		case "$_a6" in
			fe80:*|FE80:*|fc*|FC*|fd*|FD*|127.*|::1) ;;
			*:*) _wv6="$_a6"; break ;;
		esac
	done
	[ -n "$_wv6" ] && return
	set -- $1
	_wv6=$1
}

# uci device='@wan' makes $1 an alias riding wan's link. netifd resolves the
# "@" away before status reports it, so only uci still shows it.
_wi_alias_of() {
	_walias=""
	case "$_wi_uci" in
		*"network.$1.device='@"*)
			_walias=${_wi_uci#*network.$1.device=\'@}
			_walias=${_walias%%\'*}
			;;
	esac
}

# Delegated IPv6 prefix, taken from the alias's parent when it has none.
_wi_prefix() {
	_wpfx=${_p_addr:-$_pa_addr}
	_wpfxlen=${_p_mask:-$_pa_mask}
	if [ -n "$_wpfx" ] || [ -z "$_walias" ]; then
		return
	fi
	_ast=$(ubus call "network.interface.$_walias" status 2>/dev/null)
	[ -n "$_ast" ] || return
	eval "$(printf '%s' "$_ast" | jsonfilter \
		-e '_p_addr=@["ipv6-prefix"][0].address' \
		-e '_p_mask=@["ipv6-prefix"][0].mask' \
		-e '_pa_addr=@["ipv6-prefix-assignment"][0].address' \
		-e '_pa_mask=@["ipv6-prefix-assignment"][0].mask' 2>/dev/null)" 2>/dev/null
	_wpfx=${_p_addr:-$_pa_addr}
	_wpfxlen=${_p_mask:-$_pa_mask}
}

# Last NAT test result for $1, used only while it matches the current IPv4
# address (the test is IPv4 only). A fresh boot seeds the cache from
# persist_dir, so a result saved before a power cut shows again by itself.
_wi_nat4() {
	_wi_n4s=""; _wi_n4m=""; _wi_n4f=""; _wi_n4a=0
	[ "$WI_STUN" = "1" ] || return
	_wi_nat_cache="$NAT_CACHE_DIR/nat.$1"
	if [ ! -f "$_wi_nat_cache" ] && [ -n "$PERSISTDIR" ] \
		&& [ -f "$PERSISTDIR/nat/$1" ] && _persist_mount_ok "$PERSISTDIR"; then
		cat "$PERSISTDIR/nat/$1" > "$_wi_nat_cache" 2>/dev/null
	fi
	[ -f "$_wi_nat_cache" ] || return
	while read -r _wi_nf _wi_na _wi_ns _wi_nm _wi_nfi _wi_nt _wi_np _wextra; do
		case "$_wi_nt" in ''|*[!0-9]*) continue ;; esac
		case "$_wi_nf:$_wi_na" in
			4:"$_wv4") [ -n "$_wv4" ] && { _wi_n4s=$_wi_ns; _wi_n4m=$_wi_nm; _wi_n4f=$_wi_nfi; _wi_n4a=$((HWDASH_NOW - _wi_nt)); } ;;
		esac
	done < "$_wi_nat_cache"
}

# Classifies the IPv4 side. The collector already knows the real egress
# address, so an interface address that differs from it means NAT in front,
# and one in 100.64.0.0/10 (RFC 6598) names that NAT as the carrier's.
_wi_classify() {
	case "$_wv4" in
		'') _wclass="none" ;;
		0.*) _wclass="thisnet" ;;
		10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) _wclass="private" ;;
		127.*) _wclass="loopback" ;;
		169.254.*) _wclass="linklocal" ;;
		192.0.0.*) _wclass="protocol" ;;
		192.0.2.*|198.51.100.*|203.0.113.*) _wclass="testnet" ;;
		198.1[89].*) _wclass="benchmark" ;;
		100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) _wclass="cgnat" ;;
		22[4-9].*|23[0-9].*) _wclass="multicast" ;;
		24[0-9].*|25[0-5].*) _wclass="reserved" ;;
		*) _wclass="public" ;;
	esac
	if [ "$_wclass" = "public" ] && [ -n "$_wpub" ] && [ "$_wpub" != "$_wv4" ]; then
		_wclass="natted"
	fi
	if [ "$_wclass" = "none" ] && [ -n "$_wv6" ]; then
		_wclass="v6only"
	fi
	_wmon_st="up"
	[ -f "$WI_DIR/$1.stats" ] && read -r _ _ _wmon_st _ < "$WI_DIR/$1.stats" 2>/dev/null
	if [ "$_wmon_st" = "down" ]; then
		if [ -z "$_wv4" ] && [ -n "$_wv6" ]; then
			_wclass="v6only"
		else
			_wclass="unreachable"
		fi
	fi
}

# Static vs dynamic depends on how the address was obtained, which only the
# protocol knows.
_wi_assign() {
	case "$1" in
		static) _wassign="static" ;;
		dhcp|dhcpv6|pppoe|pppoa|ppp|l2tp|pptp|wwan|qmi|ncm|mbim) _wassign="dynamic" ;;
		'') _wassign="unknown" ;;
		*) _wassign="dynamic" ;;
	esac
}

# Sets _item to interface $1's JSON object; fails for one with no status or
# no address.
_wi_item() {
	_wst=$(ubus call "network.interface.$1" status 2>/dev/null)
	[ -z "$_wst" ] && return 1
	_wi_parse_status "$_wst"
	_wi_pick_v6 "$_wv6_all"
	if [ -z "$_wv4" ] && [ -z "$_wv6" ] && [ "$_wsnattgt" = "SNAT" ] && [ -n "$_wsnat" ]; then
		_wv4="$_wsnat"
	fi
	_wi_alias_of "$1"
	[ -z "$_wv4" ] && [ -z "$_wv6" ] && return 1
	_wi_prefix
	_wpub=""
	[ -f "$WI_DIR/$1.pubip" ] && read -r _wpub < "$WI_DIR/$1.pubip" 2>/dev/null
	_wi_nat4 "$1"
	_wi_classify "$1"
	_wi_assign "$_wproto"
	json_esc "$_wproto"; _wprotoj=$JSV
	json_esc "$_wpar"; _wparj=$JSV
	json_esc "$_walias"; _waliasj=$JSV
	_item="{\"iface\":\"$1\",\"device\":\"$_wdev\",\"parent\":\"$_wparj\",\"alias_of\":\"$_waliasj\",\"proto\":\"$_wprotoj\",\"up\":${_wup:-false},\"class\":\"$_wclass\",\"assign\":\"$_wassign\",\"ip4\":\"$_wv4\",\"mask4\":\"${_wm4:-0}\",\"pub4\":\"$_wpub\",\"ip6\":\"$_wv6\",\"prefix6\":\"$_wpfx\",\"prefix6_len\":\"${_wpfxlen:-0}\",\"nat4_state\":\"$_wi_n4s\",\"nat4_mapping\":\"$_wi_n4m\",\"nat4_filtering\":\"$_wi_n4f\",\"nat4_age\":$_wi_n4a}"
}

_wan_ips() {
	HWDASH_NOW=$(date +%s 2>/dev/null)
	WI_STUN=0
	_has_stunclient && WI_STUN=1
	PERSISTDIR_V=""; PERSISTDIR=""
	[ -f "$WI_DIR/.persist_dir" ] && . "$WI_DIR/.persist_dir" 2>/dev/null
	[ "$PERSISTDIR_V" != "1" ] && PERSISTDIR=""
	WI_ITEMS=""
	_wi_load_tracked
	# One uci snapshot for the whole call, read by _wi_alias_of.
	_wi_uci=$(uci -q show network 2>/dev/null)
	for _wif in $_wi_ifaces; do
		# LAN is tracked only as an access point's uplink, which has no NAT
		# to test; the AP Mode card covers it.
		case "$_wif" in loopback|lan|lan6) continue ;; esac
		_wi_item "$_wif" || continue
		WI_ITEMS="$WI_ITEMS${WI_ITEMS:+,}$_item"
	done
	echo "{\"stunclient\":$WI_STUN,\"wans\":[$WI_ITEMS]}"
}

case "$1" in
	list)
		echo '{ "wan_ips": { } }'
		;;
	call)
		case "$2" in
			wan_ips)
				_wan_ips
				;;
		esac
		;;
esac

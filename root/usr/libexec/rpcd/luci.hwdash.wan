#!/bin/sh

. /usr/share/hwdash/rpcd-common.sh

WM_DIR=/tmp/hwdash_wanmon

_wm_load_tracked() {
	_wm_tr=""
	[ -f "$WM_DIR/.tracked" ] || return
	while read -r _tif; do
		[ -n "$_tif" ] && _wm_tr="$_wm_tr $_tif"
	done < "$WM_DIR/.tracked"
}

# The ISP for $1, else its v4/v6 sibling's.
_wm_read_isp() {
	_isp=""
	[ -f "$WM_DIR/$1.isp" ] && read -r _isp < "$WM_DIR/$1.isp" 2>/dev/null
	[ -n "$_isp" ] && return
	case "$1" in
		*6) [ -f "$WM_DIR/${1%6}.isp" ] && read -r _isp < "$WM_DIR/${1%6}.isp" 2>/dev/null ;;
		*)  [ -f "$WM_DIR/${1}6.isp" ] && read -r _isp < "$WM_DIR/${1}6.isp" 2>/dev/null ;;
	esac
}

# Builtin read, not grep|awk: this runs per interface on a 2 s poll.
_wm_read_alias() {
	_alias=""
	[ -f "$WM_DIR/.aliases" ] || return
	while read -r _al_child _al_parent; do
		if [ "$_al_child" = "$1" ]; then
			_alias=$_al_parent
			break
		fi
	done < "$WM_DIR/.aliases"
}

# The collector rewrites stats files in place every tick, so a read can land
# on a truncated copy. Accept only a full line and retry once, rather than
# have the collector pay for a rename every tick.
_wm_read_stats() {
	_try=0
	while :; do
		_total=0; _success=0; _status="unknown"
		_streak_start=$_uptime_now
		_lastgood_ms="x"; _consec_miss=0
		# The last field present means all six are.
		read -r _total _success _status _streak_start _lastgood_ms _consec_miss < "$1" 2>/dev/null && \
			[ -n "$_consec_miss" ] && break
		_try=$((_try + 1))
		[ "$_try" -ge 2 ] && break
	done
	case "$_total" in ''|*[!0-9]*) _total=0 ;; esac
	case "$_success" in ''|*[!0-9]*) _success=0 ;; esac
	case "$_streak_start" in ''|*[!0-9]*) _streak_start=$_uptime_now ;; esac
	case "$_status" in up|down) ;; *) _status="unknown" ;; esac
}

# The collector's rolling 24 h window, preferred over all-time counts.
_wm_read_day() {
	_day_total=0; _day_success=0
	read -r _day_total _day_success < "$1" 2>/dev/null
	case "$_day_total" in ''|*[!0-9]*) _day_total=0 ;; esac
	case "$_day_success" in ''|*[!0-9]*) _day_success=0 ;; esac
	[ "$_day_total" -gt 0 ] && { _total=$_day_total; _success=$_day_success; }
}

_wm_pct() {
	_uptime=0; _downtime=0
	[ "${_total:-0}" -gt 0 ] || return
	_u100=$(( _success * 10000 / _total ))
	# A bucket rollover or torn read can leave success > total; clamp so
	# downtime never goes negative and renders as healthy.
	[ "$_u100" -gt 10000 ] && _u100=10000
	[ "$_u100" -lt 0 ] && _u100=0
	_d100=$(( 10000 - _u100 ))
	_uptime=$(printf '%d.%02d' $((_u100 / 100)) $((_u100 % 100)))
	_downtime=$(printf '%d.%02d' $((_d100 / 100)) $((_d100 % 100)))
}

# Sets _ms to latency $2 while status $1 is up and has a measured value.
_wm_live_ms() {
	_ms=null
	[ "$1" = "up" ] || return
	case "$2" in ''|x|*[!0-9]*) ;; *) _ms=$2 ;; esac
}

_wm_read_rate() {
	_rxbps=0; _txbps=0; _rdev=""
	[ -f "$WM_DIR/$1.rate" ] && read -r _ _ _ _rxbps _txbps _rdev < "$WM_DIR/$1.rate" 2>/dev/null
	case "$_rxbps" in ''|*[!0-9]*) _rxbps=0 ;; esac
	case "$_txbps" in ''|*[!0-9]*) _txbps=0 ;; esac
	case "$_rdev" in -) _rdev="" ;; esac
}

# Sets _item to the wan_quality object for interface $1, stats file $2.
_wm_wan_item() {
	_wm_read_isp "$1"
	_wm_read_alias "$1"
	json_esc "$_isp"; _ispj=$JSV
	json_esc "$1"; _ifnj=$JSV
	json_esc "$_alias"; _aliasj=$JSV
	_wm_read_stats "$2"
	_wm_read_day "$WM_DIR/$1.daystats"
	_wm_pct
	_wm_live_ms "$_status" "$_lastgood_ms"
	_streak=$((_uptime_now - _streak_start))
	[ "$_streak" -lt 0 ] && _streak=0
	# The collector's diagnosis, only while down: next to a healthy link a
	# leftover one would read as a fault.
	_rcode=""; _reason=""
	if [ "$_status" = "down" ] && [ -f "$WM_DIR/$1.reason" ]; then
		read -r _ _rcode _reason < "$WM_DIR/$1.reason" 2>/dev/null
	fi
	json_esc "$_rcode"; _rcodej=$JSV
	json_esc "$_reason"; _reasonj=$JSV
	_wm_read_rate "$1"
	json_esc "$_rdev"; _rdevj=$JSV
	_item="{\"iface\":\"$_ifnj\",\"alias_of\":\"$_aliasj\",\"isp\":\"$_ispj\",\"status\":\"$_status\",\"uptime_pct\":$_uptime,\"downtime_pct\":$_downtime,\"cur_ms\":$_ms,\"since_change_s\":$_streak,\"down_code\":\"$_rcodej\",\"down_reason\":\"$_reasonj\",\"rx_bps\":$_rxbps,\"tx_bps\":$_txbps,\"rate_dev\":\"$_rdevj\"}"
}

# Only reads what the collector last wrote, never probes, so the card can
# poll it every 2 s.
_wm_wan_quality() {
	WAN_QUALITY="null"
	if [ -d "$WM_DIR" ]; then
		_wm_load_tracked
		read -r _uptime_now _ < /proc/uptime; _uptime_now=${_uptime_now%%.*}
		_items=""
		for _ring in "$WM_DIR"/*.stats; do
			[ -f "$_ring" ] || continue
			_ifn=${_ring##*/}; _ifn=${_ifn%.stats}
			# A tracked interface that is down keeps its row: the collector
			# feeds it outage samples.
			case " $_wm_tr " in *" $_ifn "*) ;; *) continue ;; esac
			_wm_wan_item "$_ifn" "$_ring"
			_items="$_items${_items:+,}$_item"
		done
		[ -n "$_items" ] && WAN_QUALITY="[$_items]"
	fi
	# Written by the collector when LAN is the only uplink, so the card stops
	# calling it a WAN.
	WM_APMODE=false
	[ -f "$WM_DIR/.apmode" ] && WM_APMODE=true
	echo "{\"wan_quality\":$WAN_QUALITY,\"ap_mode\":$WM_APMODE}"
}

# Sets _ap_dev and _ap_mgmt: this AP's own device and address on $1, what an
# admin types into a browser, as opposed to the upstream gateway.
_wm_ap_addr() {
	_ap_dev=""; _ap_mgmt=""
	_ap_st=$(ubus call network.interface."$1" status 2>/dev/null)
	[ -n "$_ap_st" ] || return
	_ap_dev=$(printf '%s' "$_ap_st" | jsonfilter -e '@.l3_device' 2>/dev/null)
	if [ "$2" = "6" ]; then
		_ap_mgmt=$(printf '%s' "$_ap_st" | jsonfilter -e '@["ipv6-address"][0].address' 2>/dev/null)
	else
		_ap_mgmt=$(printf '%s' "$_ap_st" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
	fi
}

_wm_add_vlan() {
	case " $_vlans " in *" $1 "*) ;; *) _vlans="$_vlans $1" ;; esac
}

# Adds the vlan of every bridge-vlan section in the uci snapshot whose device
# is $1.
_wm_bridge_vlans() {
	_q="'"
	_cur_dev=""; _cur_vlan=""; _cur_idx=""
	while read -r _bv_l; do
		case "$_bv_l" in
			"network.@bridge-vlan["*.*=*)
				_bv_rest=${_bv_l#network.@bridge-vlan[}
				_idx=${_bv_rest%%]*}
				_prop=${_bv_rest#*].}
				if [ "$_idx" != "$_cur_idx" ]; then
					[ "$_cur_dev" = "$1" ] && [ -n "$_cur_vlan" ] && _wm_add_vlan "$_cur_vlan"
					_cur_idx="$_idx"
					_cur_dev=""
					_cur_vlan=""
				fi
				case "$_prop" in
					device=*)
						_v=${_prop#*=}
						_v=${_v#"$_q"}; _cur_dev=${_v%"$_q"}
						;;
					vlan=*)
						_v=${_prop#*=}
						_v=${_v#"$_q"}; _cur_vlan=${_v%"$_q"}
						;;
				esac
				;;
		esac
	done <<EOF_BV
$_ap_uci
EOF_BV
	[ "$_cur_dev" = "$1" ] && [ -n "$_cur_vlan" ] && _wm_add_vlan "$_cur_vlan"
}

# Sets _vlans to the VLANs device $1 carries. A "base.NNN" name is a classic
# 8021q device; a vlan-filtering bridge never has the suffix, so its
# bridge-vlan sections are checked as well.
_wm_vlans() {
	_vlans=""
	case "$1" in
		*.[0-9]*)
			_vs=${1##*.}
			case "$_vs" in ''|*[!0-9]*) ;; *) _vlans=$_vs ;; esac
			;;
	esac
	[ -n "$1" ] && [ -n "$_ap_uci" ] && _wm_bridge_vlans "$1"
	_vlans=${_vlans# }
}

# Sets _item to the ap_stats object for AP uplink $1, gateway stats file $2.
_wm_ap_item() {
	_family=4
	case "$1" in *6) _family=6 ;; esac
	_gw=""
	[ -f "$WM_DIR/$1.gw" ] && read -r _gw < "$WM_DIR/$1.gw" 2>/dev/null
	[ "$_gw" = "-" ] && _gw=""
	_wm_ap_addr "$1" "$_family"
	_wm_vlans "$_ap_dev"
	json_esc "$_ap_mgmt"; _mgmtj=$JSV
	json_esc "$_vlans"; _vlansj=$JSV
	_wm_read_stats "$2"
	_wm_read_day "$WM_DIR/$1.gwdaystats"
	_wm_pct
	_wm_live_ms "$_status" "$_lastgood_ms"; _gwms=$_ms
	_streak=$((_uptime_now - _streak_start))
	[ "$_streak" -lt 0 ] && _streak=0
	# Prefer the gateway's own reason; netifd withdrawing the route is the
	# same root cause for both streams.
	_rcode=""; _reason=""
	if [ "$_status" = "down" ]; then
		if [ -f "$WM_DIR/$1.gwreason" ]; then
			read -r _ _rcode _reason < "$WM_DIR/$1.gwreason" 2>/dev/null
		elif [ -f "$WM_DIR/$1.reason" ]; then
			read -r _ _rcode _reason < "$WM_DIR/$1.reason" 2>/dev/null
		fi
	fi
	json_esc "$_rcode"; _rcodej=$JSV
	json_esc "$_reason"; _reasonj=$JSV
	# The internet-ping stream is informational and never drives status.
	_istatus="unknown"; _ims=null
	if [ -f "$WM_DIR/$1.stats" ]; then
		_ilg="x"
		read -r _ _ _istatus _ _ilg _ < "$WM_DIR/$1.stats" 2>/dev/null
		case "$_istatus" in up|down) ;; *) _istatus="unknown" ;; esac
		_wm_live_ms "$_istatus" "$_ilg"; _ims=$_ms
	fi
	_wm_read_isp "$1"
	json_esc "$_isp"; _ispj=$JSV
	json_esc "$1"; _ifnj=$JSV
	json_esc "$_gw"; _gwj=$JSV
	_wm_read_rate "$1"
	json_esc "$_rdev"; _rdevj=$JSV
	_item="{\"iface\":\"$_ifnj\",\"family\":$_family,\"gateway\":\"$_gwj\",\"management_ip\":\"$_mgmtj\",\"vlan\":\"$_vlansj\",\"status\":\"$_status\",\"uptime_pct\":$_uptime,\"downtime_pct\":$_downtime,\"gw_ms\":$_gwms,\"since_change_s\":$_streak,\"down_code\":\"$_rcodej\",\"down_reason\":\"$_reasonj\",\"inet_status\":\"$_istatus\",\"inet_ms\":$_ims,\"isp\":\"$_ispj\",\"rx_bps\":$_rxbps,\"tx_bps\":$_txbps,\"rate_dev\":\"$_rdevj\"}"
}

# Only an access point has anything to report; everywhere else .apmode is
# absent and this returns at once.
_wm_ap_stats() {
	WM_APMODE=false
	AP_STATS="null"
	if [ -f "$WM_DIR/.apmode" ]; then
		WM_APMODE=true
		_wm_load_tracked
		read -r _uptime_now _ < /proc/uptime; _uptime_now=${_uptime_now%%.*}
		# One uci snapshot for the whole call, read by _wm_bridge_vlans.
		_ap_uci=$(uci -q show network 2>/dev/null)
		_items=""
		for _ring in "$WM_DIR"/*.gwstats; do
			[ -f "$_ring" ] || continue
			_ifn=${_ring##*/}; _ifn=${_ifn%.gwstats}
			case " $_wm_tr " in *" $_ifn "*) ;; *) continue ;; esac
			_wm_ap_item "$_ifn" "$_ring"
			_items="$_items${_items:+,}$_item"
		done
		[ -n "$_items" ] && AP_STATS="[$_items]"
	fi
	echo "{\"ap_mode\":$WM_APMODE,\"ap_stats\":$AP_STATS}"
}

case "$1" in
	list)
		echo '{ "wan_quality": { }, "ap_stats": { } }'
		;;
	call)
		case "$2" in
			wan_quality)
				_wm_wan_quality
				;;
			ap_stats)
				_wm_ap_stats
				;;
		esac
		;;
esac

#!/bin/sh

. /usr/share/hwdash/rpcd-common.sh

# Anything but dnsmasq on :53 (AdGuard Home, Pi-hole, Unbound) logs every query,
# and this card is the package's heaviest DNS user, so its lookups bypass it.
# Cached for an hour: this method runs about once a second.
HWDASH_DNS=""
_dns_bypass() {
	if _cache_read /tmp/hwdash_dnssrv.cache; then
		[ "$C_VAL" = "-" ] && HWDASH_DNS="" || HWDASH_DNS="$C_VAL"
		return
	fi
	_own=""
	if command -v netstat >/dev/null 2>&1; then
		_own=$(netstat -lnp 2>/dev/null | awk '$4 ~ /:53$/ && $NF ~ /\// {
			n = split($NF, a, "/"); print a[n]; exit }')
	fi
	[ -z "$_own" ] && { pgrep -x dnsmasq >/dev/null 2>&1 && _own=dnsmasq; }
	case "$_own" in
		dnsmasq) HWDASH_DNS="" ;;
		*) HWDASH_DNS="1.1.1.1" ;;
	esac
	_cache_write /tmp/hwdash_dnssrv.cache 3600 "${HWDASH_DNS:--}"
}

# Prints the address of $1 (family $2) from the bypass resolver, or nothing if
# it cannot; the caller then pings the name rather than lose the probe.
_resolve_off_resolver() {
	[ -z "$HWDASH_DNS" ] && return
	_rqt=A; [ "$2" = "6" ] && _rqt=AAAA
	_rres=$(nslookup -type="$_rqt" "$1" "$HWDASH_DNS" 2>/dev/null | \
		awk 'BEGIN { s = 0 } /^Name:/ { s = 1 } s && /^Address/ { print $NF; exit }')
	case "$_rres" in ''|*[!0-9a-fA-F.:]*) return ;; esac
	printf '%s' "$_rres"
}

_is_name() {
	case "$1" in *:*) return 1 ;; *[!0-9.]*) return 0 ;; esac
	return 1
}

# _map_get MAP KEY sets _MV to KEY's value in a "k=v;k=v" map, or empty.
_map_get() {
	_MV=""
	case ";$1;" in
		*";$2="*)
			_MV=";$1;"
			_MV=${_MV#*";$2="}
			_MV=${_MV%%;*}
			;;
	esac
}

# Appends "<host> <4|6>" lines from stdin to _PT_LIST. Hosts end up on a ping
# command line, so only hostname and address characters are accepted.
_pt_parse() {
	while read -r _pt_h _pt_f _; do
		case "$_pt_h" in ''|*[!A-Za-z0-9.:-]*) continue ;; esac
		case "$_pt_f" in 4|6) ;; *) _pt_f=4 ;; esac
		_PT_LIST="$_PT_LIST$_pt_h $_pt_f
"
	done
}

# Targets from the first source that has any: the RPC's "targets" array (set in
# the settings panel), /etc/hwdash-ping.targets, then the built-in list.
_ping_targets() {
	_PT_LIST=""
	if [ -n "$1" ] && command -v jsonfilter >/dev/null; then
		_pt_parse <<EOF
$(printf '%s' "$1" | jsonfilter -e '@.targets[*]' 2>/dev/null)
EOF
	fi
	[ -z "$_PT_LIST" ] && [ -f /etc/hwdash-ping.targets ] && _pt_parse < /etc/hwdash-ping.targets
	[ -z "$_PT_LIST" ] && _PT_LIST="dns.google 4
dns.google 6
google.com 4
google.com 6
one.one.one.one 4
one.one.one.one 6
youtube.com 4
youtube.com 6
"
}

# Default IPv4 gateway into _GW. /proc/net/route holds it as little-endian hex.
_gateway4() {
	_GW=""
	while read -r _rif _rdst _rgw _rflg _; do
		[ "$_rdst" = "00000000" ] || continue
		case "$_rgw" in *[!0-9A-Fa-f]*|"") continue ;; esac
		[ "$_rgw" = "00000000" ] && continue
		_b1=${_rgw#??????}
		_b2=${_rgw#????}; _b2=${_b2%??}
		_b3=${_rgw#??}; _b3=${_b3%????}
		_b4=${_rgw%??????}
		_GW="$((0x$_b1)).$((0x$_b2)).$((0x$_b3)).$((0x$_b4))"
		break
	done < /proc/net/route
}

# Default IPv6 gateway into _GW6, cached 60 s: the first default route (ip lists
# the lowest metric first), else netifd's WAN route. A link-local keeps its
# %zone so the probe works; it is stripped from everything shown.
_gateway6() {
	_GW6=""
	if _cache_read /tmp/hwdash_gw6.cache; then
		[ "$C_VAL" != "-" ] && _GW6=$C_VAL
		return
	fi
	if command -v ip >/dev/null; then
		while read -r _d6 _via6 _g6 _dev6 _if6 _; do
			[ "$_d6" = "default" ] || continue
			[ "$_via6" = "via" ] || continue
			_GW6=$_g6
			case "$_g6" in
				fe80:*) [ "$_dev6" = "dev" ] && _GW6="$_g6%$_if6" ;;
			esac
			break
		done <<EOF
$(ip -6 route show default 2>/dev/null)
EOF
	fi
	if [ -z "$_GW6" ] && command -v jsonfilter >/dev/null; then
		for _w6 in wan6 wan_6 wan; do
			_ifn6=$(ubus call network.interface.$_w6 status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
			_g6=$(ubus call network.interface.$_w6 status 2>/dev/null | jsonfilter -e '@.route[0].nexthop' 2>/dev/null)
			case "$_g6" in
				'') ;;
				fe80:*) _GW6="$_g6${_ifn6:+%$_ifn6}"; break ;;
				*:*) _GW6=$_g6; break ;;
			esac
		done
	fi
	_cache_write /tmp/hwdash_gw6.cache 60 "${_GW6:--}"
}

# The first hop leads the list: spikes there mean the local link, while a flat
# first hop under spiking internet targets points at the ISP or beyond.
_prepend_gateways() {
	_head=""
	[ -n "$_GW" ] && ! _listed "$_GW 4" && _head="$_GW 4
"
	[ -n "$_GW6" ] && ! _listed "$_GW6 6" && _head="$_head$_GW6 6
"
	_PT_LIST="$_head$_PT_LIST"
}

# 0 when the "<host> <family>" line $1 is already in _PT_LIST.
_listed() {
	case "
$_PT_LIST" in *"
$1
"*) return 0 ;; esac
	return 1
}

# Reverse DNS for IP-literal targets comes from a detached job into a 30-minute
# cache, never the request path. Failures cache as "-" so they are not retried
# every second.
_rdns_refresh() {
	RDNS_MAP=""
	_cache_read /tmp/hwdash_rdns.cache && RDNS_MAP=$C_VAL
	_rdns_miss=""
	while read -r _pt_h _pt_f; do
		[ -z "$_pt_h" ] && continue
		_is_name "$_pt_h" && continue
		case ";$RDNS_MAP" in *";$_pt_h="*) continue ;; esac
		_rdns_miss="$_rdns_miss $_pt_h"
	done <<EOF
$_PT_LIST
EOF
	[ -n "$_rdns_miss" ] || return
	_cache_read /tmp/hwdash_rdns.lock && return
	_cache_write /tmp/hwdash_rdns.lock 60 resolving
	_rdns_resolve $_rdns_miss >/dev/null 2>&1 &
}

_rdns_resolve() {
	_map=$RDNS_MAP
	for _rip; do
		_bare=${_rip%%%*}
		_nm="-"
		while read -r _rl; do
			case "$_rl" in
				*" name = "*)
					_nm=${_rl##* name = }
					_nm=${_nm%.}
					break
					;;
			esac
		done <<EOF
$(nslookup "$_bare" $HWDASH_DNS 2>/dev/null)
EOF
		case "$_nm" in *[!A-Za-z0-9.-]*) _nm="-" ;; esac
		_map="${_map:+$_map;}$_rip=$_nm"
	done
	_cache_write /tmp/hwdash_rdns.cache 1800 "$_map"
}

# -n (no reverse DNS) is an iputils flag that some busybox ping builds reject,
# so it is tried once on loopback and the answer cached for an hour.
_ping_n_flag() {
	PING_N=""
	if _cache_read /tmp/hwdash_ping_n.cache; then
		PING_N=$C_VAL
	else
		ping -4 -c 1 -w 1 -n 127.0.0.1 >/dev/null 2>&1 && PING_N="-n"
		_cache_write /tmp/hwdash_ping_n.cache 3600 "$PING_N"
	fi
}

# Pings $1 (family $2) and leaves "<ms|x|?> <sent> <recv> <ip>" in file $3: "x"
# is no reply, "?" a name that never resolved. The address goes last because it
# can be empty, and only a trailing empty field survives `read`.
_probe() {
	_tgt=$1
	# Still a name means the address map missed. Resolving here, inside the
	# job, keeps it off the local resolver and lets cold names run in parallel.
	case "$_tgt" in
		*[!0-9.:]*)
			_rip=$(_resolve_off_resolver "$_tgt" "$2")
			[ -n "$_rip" ] && _tgt=$_rip
			;;
	esac
	# Two packets: anycast targets rate-limit ICMP, so one often blanks a
	# healthy row. -A sends the second as soon as the first reply lands, and
	# -w 2 caps the route/connect hangs that -W does not.
	# stderr is kept because "bad address" is the only sign that a name never
	# resolved; the parsing below keys on the banner and "time=", which stderr
	# never prints.
	_out=$(ping -"$2" -c 2 -A -w 2 -W 1 $PING_N "$_tgt" 2>&1)
	case "$_out" in
		*"bad address"*|*"unknown host"*|*"Name or service not known"*)
			printf '%s %s %s %s' '?' 0 0 '' > "$3"
			return
			;;
	esac
	# The address actually hit, from the "PING host (ip)" banner.
	_ip=""
	case "$_out" in
		*"("*")"*)
			_ip=${_out#*\(}
			_ip=${_ip%%\)*}
			case "$_ip" in *[!0-9a-fA-F:.]*) _ip="" ;; esac
			;;
	esac
	# The last reply's time, as "time=48.9 ms" or "time=48.9ms".
	_t=""
	case "$_out" in
		*time=*)
			_t=${_out##*time=}
			_t=${_t%%[!0-9.]*}
			case "$_t" in ''|.|*.*.*) _t="" ;; esac
			;;
	esac
	# Replies are "time=" lines counted against the 2 asked for. The summary is
	# no use: busybox 1.37 and 1.38 word it differently, and "transmitted"
	# overcounts when -w cuts a run short.
	_rcv=0; _pp=$_out
	while :; do
		case "$_pp" in
			*time=*) _rcv=$((_rcv + 1)); _pp=${_pp#*time=} ;;
			*) break ;;
		esac
	done
	[ "$_rcv" -gt 2 ] && _rcv=2
	printf '%s %s %s %s' "${_t:-x}" 2 "$_rcv" "$_ip" > "$3"
}

# Every target probes in parallel, so the call takes as long as the slowest.
_probe_all() {
	_pi=0; _ping_pids=""
	while read -r _pt_h _pt_f; do
		[ -z "$_pt_h" ] && continue
		_tgt=$_pt_h
		if _is_name "$_pt_h"; then
			_map_get "$DNS_MAP" "$_pt_h|$_pt_f"
			[ -n "$_MV" ] && _tgt=$_MV
		fi
		_probe "$_tgt" "$_pt_f" "$_PT_TMP.$_pi" &
		_ping_pids="$_ping_pids $!"
		_pi=$((_pi + 1))
	done <<EOF
$_PT_LIST
EOF
	# Never a bare wait: it would also block on the detached reverse-DNS job,
	# whose NXDOMAIN timeout is about 5 s.
	for _wp in $_ping_pids; do wait "$_wp" 2>/dev/null; done
}

# Reads and sanitises probe result file $1 into _ms _psnt _prcv _pip _unres.
_read_result() {
	_ms="null"; _pip=""; _psnt=0; _prcv=0; _unres=0
	[ -f "$1" ] || return
	read -r _ms _psnt _prcv _pip < "$1" 2>/dev/null
	rm -f "$1" 2>/dev/null
	# Before the sanitiser turns "?" into null, which would read as a timeout.
	[ "$_ms" = "?" ] && _unres=1
	case "$_ms" in ''|x|*[!0-9.]*) _ms="null" ;; esac
	case "$_pip" in *[!0-9a-fA-F:.]*) _pip="" ;; esac
	case "$_psnt" in ''|*[!0-9]*) _psnt=0 ;; esac
	case "$_prcv" in ''|*[!0-9]*) _prcv=0 ;; esac
	[ "$_prcv" -gt "$_psnt" ] && _prcv=$_psnt
}

# DNS-quiet mode: a name's address is cached for 30 minutes and later probes
# ping the literal. A timeout drops the entry so the next probe re-resolves,
# which heals DNS rotation. $1 is the "host|family" key.
_dns_map_update() {
	_map_get "$DNS_MAP" "$1"
	if [ "$_ms" != "null" ] && [ -n "$_pip" ]; then
		_NEW_MAP="${_NEW_MAP:+$_NEW_MAP;}$1=$_pip"
		[ "$_pip" != "$_MV" ] && _MAP_DIRTY=1
	elif [ "$_ms" = "null" ] && [ -n "$_MV" ]; then
		_MAP_DIRTY=1
	elif [ -n "$_MV" ]; then
		_NEW_MAP="${_NEW_MAP:+$_NEW_MAP;}$1=$_MV"
	fi
}

# Builds the PINGS array from the probe results, in target order.
_collect() {
	PINGS=""; _pi=0
	_NEW_MAP=""; _MAP_DIRTY=0
	while read -r _pt_h _pt_f; do
		[ -z "$_pt_h" ] && continue
		_read_result "$_PT_TMP.$_pi"
		_pi=$((_pi + 1))
		_is_name "$_pt_h" && _dns_map_update "$_pt_h|$_pt_f"
		_map_get "$RDNS_MAP" "$_pt_h"
		[ "$_MV" = "-" ] && _MV=""
		json_esc "$_MV"; _rdj=$JSV
		_unres_j=false; [ "$_unres" = "1" ] && _unres_j=true
		json_esc "${_pt_h%%%*}"
		PINGS="$PINGS${PINGS:+,}{\"host\":\"$JSV\",\"fam\":$_pt_f,\"ip\":\"$_pip\",\"rdns\":\"$_rdj\",\"ms\":$_ms,\"sent\":$_psnt,\"recv\":$_prcv,\"unresolved\":$_unres_j}"
	done <<EOF
$_PT_LIST
EOF
	PINGS="[$PINGS]"
}

_ping() {
	HWDASH_NOW=$(date +%s 2>/dev/null)
	_dns_bypass
	_IN=""
	IFS= read -r _IN 2>/dev/null
	_ping_targets "$_IN"
	_gateway4
	_gateway6
	_prepend_gateways
	_rdns_refresh
	DNS_MAP=""
	_cache_read /tmp/hwdash_dns.cache && DNS_MAP=$C_VAL
	_ping_n_flag
	_PT_TMP="/tmp/hwdash_ping.$$"
	_probe_all
	_collect
	[ "$_MAP_DIRTY" = "1" ] && _cache_write /tmp/hwdash_dns.cache 1800 "$_NEW_MAP"
	json_esc "${_GW6%%%*}"
	echo "{\"gateway\":\"$_GW\",\"gateway6\":\"$JSV\",\"targets\":$PINGS}"
}

case "$1" in
	list)
		echo '{ "ping": { } }'
		;;
	call)
		case "$2" in
			ping) _ping ;;
		esac
		;;
esac

#!/bin/sh
# Background WAN-quality collector for luci-app-hw-dashboard. Measurements
# live only in tmpfs; the tracked-WAN list is the one thing kept on flash.
#
# mwan3's policy routing keys on an fwmark it sets only on traffic matching
# its own rules, so a probe bound by device or source alone can leave via the
# wrong WAN. mwan3's LD_PRELOAD shim sets that mark, and is reused wherever an
# interface has an mwan3 rule.

trap '_j=$(jobs -p); [ -n "$_j" ] && kill $_j 2>/dev/null; exit 0' TERM INT

RINGDIR=/tmp/hwdash_wanmon
INTERVAL=2
# Hotplug forces rediscovery on every transition; this is only a safety net.
DISCOVER_INTERVAL=300
ISP_RETRY_INTERVAL=60
# 288 five-minute buckets: a rolling 24 h availability window.
WINDOW_BUCKET_SECS=300
WINDOW_BUCKETS=288
PING_CAP=4
# Misses in a row before a link is declared down, so one filtered ICMPv6
# reply does not flip it red.
MISS_THRESHOLD=3
# How often a down interface's netifd state is re-read to explain why.
REASON_INTERVAL=20
# Fallbacks for a target list with no distinct second entry to fail over to.
ANCHOR4=1.1.1.1
BACKUP4=8.8.8.8
ANCHOR6=2606:4700:4700::1111
BACKUP6=2001:4860:4860::8888
WRAP=/lib/mwan3/libwrap_mwan3_sockopt.so.1.0

# Public resolvers used instead of the local one, in order; the v6 entry keeps
# a v6-only uplink working.
ASN_DNS_LIST="1.1.1.1 8.8.8.8 2606:4700:4700::1111"
ASN_DNS4=1.1.1.1
# Empty means use the system resolver; set by detect_asn_dns.
ASN_DNS=""

PERSIST_DIR=/etc/hwdash
PERSIST_TRACKED="$PERSIST_DIR/tracked"
# Optional external mirror (e.g. a USB drive) from Settings, relayed by rpcd
# through .persist_dir since this daemon does not read UCI per tick.
PERSISTDIR=""
PERSIST_SYNC_INTERVAL=600
LAST_PERSIST_SYNC=0

DEFAULT_TARGETS4="1.1.1.1 8.8.8.8 9.9.9.9 1.0.0.1 8.8.4.4 149.112.112.112"
DEFAULT_TARGETS6="2606:4700:4700::1111 2001:4860:4860::8888 2620:fe::fe 2606:4700:4700::1001 2001:4860:4860::8844 2620:fe::9"
TARGETS4_LIST="$DEFAULT_TARGETS4"
TARGETS6_LIST="$DEFAULT_TARGETS6"
# Raw user targets behind the two lists, to spot a settings change.
RAW_TGT4=""
RAW_TGT6=""
# Uptime at which to retry an incomplete resolution. procd starts this long
# before any resolver is usable, so a failed first attempt is the norm.
TGT_RETRY_AT=""
TGT_RETRY_INTERVAL=300

IFACE_LIST=""
ACTIVE_IFACES=""
TRACKED_IFACES=""
LAST_DISCOVER=0
BIND_IF=""

# A filtering resolver (AdGuard Home, Pi-hole, Unbound) logs every query, so
# lookups bypass it for a public one; dnsmasq does not log per query and is
# kept. Resolved once: the resolver does not change without a restart.
detect_asn_dns() {
	ASN_DNS=""
	_owner=""
	# The :53 listener is authoritative; resolv.conf says 127.0.0.1 for either.
	if command -v netstat >/dev/null 2>&1; then
		_owner=$(netstat -lnp 2>/dev/null | awk '$4 ~ /:53$/ && $NF ~ /\// {
			n = split($NF, a, "/"); print a[n]; exit }')
	fi
	if [ -z "$_owner" ]; then
		pgrep -x dnsmasq >/dev/null 2>&1 && _owner=dnsmasq
	fi
	case "$_owner" in
		dnsmasq) ;;
		*) ASN_DNS="$ASN_DNS4" ;;
	esac
}

# One TXT lookup. When bypassing, it falls back to the next public server,
# never to the system resolver.
asn_txt() {
	_q=$1; _outf=$2
	if [ -z "$ASN_DNS" ]; then
		run_capped "$PING_CAP" "$_outf" nslookup -type=TXT "$_q"
		return
	fi
	for _srv in $ASN_DNS_LIST; do
		run_capped "$PING_CAP" "$_outf" nslookup -type=TXT "$_q" "$_srv"
		grep -q text "$_outf" 2>/dev/null && return
	done
}

# Cymru answers one TXT record per covering prefix (an operator's /24 inside
# its upstream's block). The most specific prefix names the operator actually
# selling the service; the first record covers an unparseable prefix field.
asn_pick() {
	awk -F'|' '
		BEGIN { len = 0; best = "" }
		/text/ {
			s = $0; sub(/.*= "/, "", s); sub(/".*/, "", s)
			n = split(s, f, "|")
			if (n >= 2) {
				if (best == "") best = f[1]
				p = f[2]
				sub(/.*\//, "", p)
				gsub(/[^0-9]/, "", p)
				if (p != "" && p + 0 > len) { len = p + 0; best = f[1] }
			}
		}
		END { gsub(/[^0-9]/, "", best); print best }' "$1" 2>/dev/null
}

# Only the first record, so a duplicate answer cannot join two names.
asn_org() {
	sed -n '/text/{s/.*= "//;s/".*//;s/^\([^|]*|\)\{4\}//p;q}' "$1" 2>/dev/null
}

# The first address after "Name:"; nslookup prints its server's own address
# before the answer.
nslookup_addr() {
	awk 'BEGIN { seen = 0 } /^Name:/ { seen = 1 } seen && /^Address/ { print $NF; exit }' "$1" 2>/dev/null
}

# Resolves a hostname probe target through the same bypass. Runs only when
# the target list changes.
lookup_host() {
	_h=$1; _fam=$2; _tag=$3
	_qt=A; [ "$_fam" = "6" ] && _qt=AAAA
	# Per-caller scratch file: interface jobs resolve concurrently.
	_lf="$RINGDIR/.probe.${_tag:-cfg}.host"
	_ip=""
	if [ -n "$ASN_DNS" ]; then
		for _srv in $ASN_DNS_LIST; do
			run_capped "$PING_CAP" "$_lf" nslookup -type="$_qt" "$_h" "$_srv"
			_ip=$(nslookup_addr "$_lf")
			[ -n "$_ip" ] && break
		done
	else
		run_capped "$PING_CAP" "$_lf" nslookup -type="$_qt" "$_h"
		_ip=$(nslookup_addr "$_lf")
	fi
	# A malformed reply must not become a probe target.
	case "$_ip" in *[!0-9a-fA-F.:]*|'') _ip="" ;; esac
	printf '%s' "$_ip"
}

# Globally routable IPv6: not loopback, link-local (fe80::/10) or unique-local
# (fc00::/7), none of which a registry can attribute.
is_public_ip6() {
	case "$1" in
		''|::1|::) return 1 ;;
		[fF][eE][89abAB]*|[fF][cCdD]*) return 1 ;;
		*:*) return 0 ;;
	esac
	return 1
}

# Globally routable IPv4, as far as a string can tell: not RFC 1918, CGNAT
# (RFC 6598), loopback, link-local, IETF/benchmark, multicast or reserved.
is_public_ip4() {
	case "$1" in
		''|*[!0-9.]*) return 1 ;;
		0.*|10.*|127.*|169.254.*|192.168.*|192.0.0.*|198.1[89].*) return 1 ;;
		172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 1 ;;
		100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 1 ;;
		22[4-9].*|2[3-5][0-9].*) return 1 ;;
	esac
	return 0
}

# An interface's IPv4 next hop: netifd's default route for it (PPPoE peer,
# DHCP router), else the kernel's default via its device (mwan3 keeps one per
# table).
iface_gateway4() {
	_ig=""
	read -r _ig <<EOF
$(ubus call network.interface."$1" status 2>/dev/null | jsonfilter -e '@.route[@.target="0.0.0.0"].nexthop' 2>/dev/null)
EOF
	case "$_ig" in ''|0.0.0.0) ;; *) printf '%s' "$_ig"; return ;; esac
	while read -r _ig_d _ig_v _ig_g _; do
		[ "$_ig_d" = "default" ] && [ "$_ig_v" = "via" ] && { printf '%s' "$_ig_g"; return; }
	done <<EOF
$(ip -4 route show table all default dev "$2" 2>/dev/null)
EOF
}

# Fully expanded, nibble-reversed address (ip6.arpa style) for Cymru's
# origin6 zone. Avoids strtonum() so busybox awk can run it.
ip6_nibbles() {
	printf '%s' "$1" | awk '
		BEGIN { addr = ""; head = ""; tail = ""; full = ""; out = ""; n = 0; hc = 0; tc = 0 }
		{
		addr = tolower($0); n = index(addr, "::")
		if (n > 0) { head = substr(addr, 1, n - 1); tail = substr(addr, n + 2) }
		else { head = addr; tail = "" }
		hc = (head == "") ? 0 : split(head, h, ":")
		tc = (tail == "") ? 0 : split(tail, t, ":")
		if (hc + tc > 8) exit
		for (i = 1; i <= hc; i++) if (h[i] !~ /^[0-9a-f]{1,4}$/) exit
		for (i = 1; i <= tc; i++) if (t[i] !~ /^[0-9a-f]{1,4}$/) exit
		full = ""
		for (i = 1; i <= hc; i++) full = full substr("0000" h[i], length(h[i]) + 1)
		for (i = 0; i < 8 - hc - tc; i++) full = full "0000"
		for (i = 1; i <= tc; i++) full = full substr("0000" t[i], length(t[i]) + 1)
		if (length(full) != 32) exit
		out = ""
		for (i = 32; i >= 1; i--) out = out substr(full, i, 1) (i > 1 ? "." : "")
		print out
	}'
}

# The value ends up sourced by a root shell every tick, so it is reduced to
# characters a mount path can use: nothing a sourced file could execute.
load_persist_dir() {
	_cfg_json=$(uci -q get hwdash.main.settings_json 2>/dev/null)
	[ -z "$_cfg_json" ] && return
	_pd=$(jsonfilter -s "$_cfg_json" -e '@.persistDir' 2>/dev/null)
	_pd=$(printf '%s' "$_pd" | tr -cd 'A-Za-z0-9/_.-')
	case "$_pd" in /*) PERSISTDIR=$_pd ;; *) PERSISTDIR="" ;; esac
}

# A real filesystem mounted at or above $1? An unplugged drive leaves its
# mountpoint behind as a plain directory on flash that would silently take
# the writes, so this is checked on every use, never cached.
_persist_mount_ok() {
	_pm_dir=$1
	[ -d "$_pm_dir" ] || return 1
	_pm_best=""
	while read -r _pm_dev _pm_mp _pm_fs _pm_rest; do
		case "$_pm_mp" in
			/|/overlay|/rom|/tmp|/dev|/proc|/sys) continue ;;
		esac
		case "$_pm_dir" in
			"$_pm_mp"|"$_pm_mp"/*)
				# Longest match: a path can sit under both / and /mnt/usb1.
				[ ${#_pm_mp} -gt ${#_pm_best} ] && _pm_best=$_pm_mp
				;;
		esac
	done < /proc/mounts
	[ -n "$_pm_best" ]
}

# The only writer of both persisted .tracked copies. cmp first, so a stable
# set of WANs never writes flash.
mirror_tracked() {
	if ! cmp -s "$RINGDIR/.tracked" "$PERSIST_TRACKED" 2>/dev/null; then
		mkdir -p "$PERSIST_DIR" 2>/dev/null
		cat "$RINGDIR/.tracked" > "$PERSIST_TRACKED" 2>/dev/null
		# The overlay buffers writes, and a power cut is exactly when this
		# list matters.
		sync 2>/dev/null
	fi
	if [ -n "$PERSISTDIR" ] && _persist_mount_ok "$PERSISTDIR"; then
		mkdir -p "$PERSISTDIR" 2>/dev/null
		if ! cmp -s "$RINGDIR/.tracked" "$PERSISTDIR/tracked" 2>/dev/null; then
			cat "$RINGDIR/.tracked" > "$PERSISTDIR/tracked" 2>/dev/null
		fi
	fi
}

# Discovery only finds a WAN that holds a route, so a fresh /tmp (every boot
# and upgrade) is seeded with the persisted list to keep a dead WAN visible.
seed_tracked() {
	[ -f "$RINGDIR/.tracked" ] && return
	if [ -f "$PERSIST_TRACKED" ]; then
		cat "$PERSIST_TRACKED" > "$RINGDIR/.tracked" 2>/dev/null
	elif [ -n "$PERSISTDIR" ] && [ -f "$PERSISTDIR/tracked" ] && _persist_mount_ok "$PERSISTDIR"; then
		cat "$PERSISTDIR/tracked" > "$RINGDIR/.tracked" 2>/dev/null
	fi
}

# Mirrors the 24 h window to the external persist_dir so a power cut does not
# reset every WAN's uptime. Never to /etc: this changes constantly.
sync_wan_history() {
	[ -n "$PERSISTDIR" ] || return
	_persist_mount_ok "$PERSISTDIR" || return
	_wh_dir="$PERSISTDIR/wanhist"
	mkdir -p "$_wh_dir" 2>/dev/null
	for _ifn in $TRACKED_IFACES; do
		for _sf in "$RINGDIR/$_ifn".day.* "$RINGDIR/$_ifn.daystats"; do
			[ -f "$_sf" ] || continue
			_dst="$_wh_dir/${_sf##*/}"
			cmp -s "$_sf" "$_dst" 2>/dev/null || cat "$_sf" > "$_dst" 2>/dev/null
		done
	done
}

# Startup only. A bucket that already exists means a collector restart, not a
# reboot, so tmpfs is current and is never overwritten.
seed_wan_history() {
	[ -n "$PERSISTDIR" ] || return
	_persist_mount_ok "$PERSISTDIR" || return
	_wh_dir="$PERSISTDIR/wanhist"
	[ -d "$_wh_dir" ] || return
	for _sf in "$_wh_dir"/*.day.* "$_wh_dir"/*.daystats; do
		[ -f "$_sf" ] || continue
		_dst="$RINGDIR/${_sf##*/}"
		[ -f "$_dst" ] || cat "$_sf" > "$_dst" 2>/dev/null
	done
}

# Runs a command with a wall-clock cap. nslookup has no timeout of its own and
# hangs forever on a resolver that never answers. The watchdog traps TERM to
# kill its sleep, which would otherwise be orphaned for the full delay.
run_capped() {
	_cap=$1; _outf=$2; shift 2
	"$@" > "$_outf" 2>/dev/null &
	_rp=$!
	(
		trap 'kill $_cs 2>/dev/null; exit 0' TERM
		sleep "$_cap" & _cs=$!
		wait $_cs
		kill -9 "$_rp" 2>/dev/null
	) &
	_wd=$!
	wait "$_rp" 2>/dev/null
	kill "$_wd" 2>/dev/null
	wait "$_wd" 2>/dev/null
}

# ping bounds itself with -w/-W, so the per-tick probe skips the watchdog fork.
run_probe() {
	_outf=$1; shift
	"$@" > "$_outf" 2>/dev/null
}

# Probes bind to the device, falling back to the source address. A
# source-bound socket still routes by the main table on a policy-routed box,
# and some carriers drop v6 echoes sent from the /128.
bind_arg() {
	BIND_IF=${1:-$2}
}

do_ping() {
	_dev=$1; _srcip=$2; _mark=$3; _family=$4; _anchor=$5; _ifn=$6
	_famtag="ipv4"; [ "$_family" = "6" ] && _famtag="ipv6"
	_pf="$RINGDIR/.probe.${_ifn}.ping"
	if [ "$_mark" != "-" ]; then
		run_probe "$_pf" \
			env FAMILY="$_famtag" DEVICE="$_dev" SRCIP="$_srcip" FWMARK="$_mark" LD_PRELOAD="$WRAP" \
			ping -"$_family" -c 2 -A -w 2 -W 1 "$_anchor"
	else
		bind_arg "$_dev" "$_srcip"
		if [ -n "$BIND_IF" ]; then
			run_probe "$_pf" ping -"$_family" -I "$BIND_IF" -c 2 -A -w 2 -W 1 "$_anchor"
		else
			run_probe "$_pf" ping -"$_family" -c 2 -A -w 2 -W 1 "$_anchor"
		fi
	fi
	while IFS= read -r _line || [ -n "$_line" ]; do
		printf '%s ' "$_line"
	done < "$_pf" 2>/dev/null
}

ping_with_backup() {
	_dev=$1; _srcip=$2; _mark=$3; _family=$4; _ifn=$5; _anchor=$6; _backup=$7
	_out=$(do_ping "$_dev" "$_srcip" "$_mark" "$_family" "$_anchor" "$_ifn")
	case "$_out" in
		*time=*) printf '%s' "$_out"; return ;;
	esac
	_out=$(do_ping "$_dev" "$_srcip" "$_mark" "$_family" "$_backup" "$_ifn")
	case "$_out" in
		*time=*) printf '%s' "$_out"; return ;;
	esac
	if [ "$_family" = "6" ]; then
		_fb="2001:4860:4860::8888"
		[ "$_anchor" = "$_fb" ] || [ "$_backup" = "$_fb" ] && _fb="2606:4700:4700::1111"
	else
		_fb="8.8.8.8"
		[ "$_anchor" = "$_fb" ] || [ "$_backup" = "$_fb" ] && _fb="1.1.1.1"
	fi
	do_ping "$_dev" "$_srcip" "$_mark" "$_family" "$_fb" "$_ifn"
}

# Extra arguments after $5 go to curl (--resolve pins a name so curl never
# asks the local resolver). curl is a hard dependency; the fetch fallbacks do
# not take them.
do_curl() {
	_dev=$1; _srcip=$2; _mark=$3; _url=$4; _ifn=$5
	shift 5
	_out=""
	if command -v curl >/dev/null 2>&1; then
		if [ "$_mark" != "-" ]; then
			_out=$(env FAMILY=ipv4 DEVICE="$_dev" SRCIP="$_srcip" FWMARK="$_mark" LD_PRELOAD="$WRAP" \
				curl -s --max-time 5 "$@" "$_url" 2>/dev/null)
		else
			bind_arg "$_dev" "$_srcip"
			_out=$(curl -s --interface "$BIND_IF" --max-time 5 "$@" "$_url" 2>/dev/null)
		fi
	elif command -v uclient-fetch >/dev/null 2>&1; then
		_out=$(uclient-fetch -q --timeout=5 -O - "$_url" 2>/dev/null)
	elif command -v wget >/dev/null 2>&1; then
		_out=$(wget -q --timeout=5 -O - "$_url" 2>/dev/null)
	fi
	printf '%s' "$_out" | tr '\n' ' '
}

# Public IPv4 behind carrier NAT. The lookup hosts are resolved through the
# bypass and pinned with --resolve, which every curl build has (unlike
# --dns-servers).
get_public_ip4() {
	_dev=$1; _srcip=$2; _mark=$3; _ifn=$4
	_pub=""
	if [ -z "$ASN_DNS" ]; then
		_pub=$(do_curl "$_dev" "$_srcip" "$_mark" https://api.ipify.org "$_ifn")
		[ -z "$_pub" ] && _pub=$(do_curl "$_dev" "$_srcip" "$_mark" https://icanhazip.com "$_ifn")
		printf '%s' "$_pub" | tr -d ' \r\n'
		return
	fi
	_ipify=$(lookup_host api.ipify.org 4 "$_ifn")
	if [ -n "$_ipify" ]; then
		_pub=$(do_curl "$_dev" "$_srcip" "$_mark" https://api.ipify.org "$_ifn" \
			--resolve "api.ipify.org:443:$_ipify")
	fi
	if [ -z "$_pub" ]; then
		_ican=$(lookup_host icanhazip.com 4 "$_ifn")
		if [ -n "$_ican" ]; then
			_pub=$(do_curl "$_dev" "$_srcip" "$_mark" https://icanhazip.com "$_ifn" \
				--resolve "icanhazip.com:443:$_ican")
		fi
	fi
	printf '%s' "$_pub" | tr -d ' \r\n'
}

# Turns user targets into addresses once, so ping never resolves per tick. A
# name that will not resolve is dropped, not passed through: ping would
# re-resolve it every probe via the very resolver being avoided.
resolve_target() {
	_val=$1; _fam=$2
	_res=""
	for _t in $_val; do
		case "$_t" in
			*[a-zA-Z]*)
				_ip=$(lookup_host "$_t" "$_fam" cfg)
				[ -n "$_ip" ] && _res="$_res $_ip"
				;;
			*) _res="$_res $_t" ;;
		esac
	done
	printf '%s' "${_res# }"
}

# Sets _rl to raw list $1 resolved for family $2, else default list $3.
# resolve_target runs in a subshell and cannot flag a failure, so fewer
# addresses out than names in sets _at_short.
resolve_list() {
	if [ -z "$1" ]; then
		_rl=$3
		return
	fi
	_r=$(resolve_target "$1" "$2")
	_rl=${_r:-$3}
	set -- $1; _at_want=$#
	set -- $_r; [ $# -lt "$_at_want" ] && _at_short=1
}

# $1/$2 = raw wanTarget4/6 from settings, empty for the built-in spread.
# Succeeds only when the effective lists changed, i.e. the per-interface
# targets cached in IFACE_LIST are stale.
apply_targets() {
	_at4=$1; _at6=$2
	if [ "$_at4" = "$RAW_TGT4" ] && [ "$_at6" = "$RAW_TGT6" ]; then
		# Unchanged: redo it only when a retry of unresolved names is due.
		[ -z "$TGT_RETRY_AT" ] && return 1
		read -r _at_now _ < /proc/uptime
		[ "${_at_now%%.*}" -lt "$TGT_RETRY_AT" ] && return 1
	fi
	RAW_TGT4=$_at4; RAW_TGT6=$_at6
	_at_old4=$TARGETS4_LIST; _at_old6=$TARGETS6_LIST
	_at_short=0
	resolve_list "$RAW_TGT4" 4 "$DEFAULT_TARGETS4"; TARGETS4_LIST=$_rl
	resolve_list "$RAW_TGT6" 6 "$DEFAULT_TARGETS6"; TARGETS6_LIST=$_rl
	if [ "$_at_short" = "1" ]; then
		read -r _at_now _ < /proc/uptime
		TGT_RETRY_AT=$(( ${_at_now%%.*} + TGT_RETRY_INTERVAL ))
	else
		TGT_RETRY_AT=""
	fi
	[ "$TARGETS4_LIST" = "$_at_old4" ] && [ "$TARGETS6_LIST" = "$_at_old6" ] && return 1
	return 0
}

load_targets() {
	_cfg_json=$(uci -q get hwdash.main.settings_json 2>/dev/null)
	[ -z "$_cfg_json" ] && return 1
	_tgt4=$(jsonfilter -s "$_cfg_json" -e '@.wanTarget4' 2>/dev/null)
	_tgt6=$(jsonfilter -s "$_cfg_json" -e '@.wanTarget6' 2>/dev/null)
	apply_targets "$_tgt4" "$_tgt6"
}

# Spreads interfaces across the target list, so WANs do not all hit one
# anycast address and one dark target cannot take every card down. Depends
# only on the name and the list, so discovery caches it in IFACE_LIST.
get_target_for_iface() {
	_ifn=$1; _family=$2; _is_backup=$3
	_targets="$TARGETS4_LIST"
	[ "$_family" = "6" ] && _targets="$TARGETS6_LIST"
	set -- $_targets
	_num_targets=$#
	if [ "$_num_targets" -le 1 ]; then
		# One target has no sibling to fail over to; the second probe uses a
		# built-in instead.
		if [ "$_family" = "6" ]; then _ta=$ANCHOR6; _tb=$BACKUP6
		else _ta=$ANCHOR4; _tb=$BACKUP4; fi
		[ "$_num_targets" -eq 1 ] && _ta=$1
		if [ "$_is_backup" = "1" ]; then
			# The user's one target may be the built-in backup itself.
			if [ "$_ta" = "$_tb" ]; then
				[ "$_family" = "6" ] && _tb=$ANCHOR6 || _tb=$ANCHOR4
			fi
			printf '%s' "$_tb"
		else
			printf '%s' "$_ta"
		fi
		return
	fi

	_hash=0
	for _c in $(printf '%s' "$_ifn" | hexdump -v -e '1/1 "%u "' 2>/dev/null); do
		_hash=$(( (_hash + _c) % _num_targets ))
	done
	[ "$_is_backup" = "1" ] && _hash=$(( (_hash + 1) % _num_targets ))
	shift "$_hash"
	printf '%s' "$1"
}

# The upstream router an AP uplink should be measured against, not a public
# anchor beyond it. Prints the gateway for family $1, or "-".
discover_gateway() {
	if [ "$1" = "6" ]; then
		gateway6
	else
		gateway4
	fi
}

gateway6() {
	_dgw=""
	if command -v ip >/dev/null; then
		while read -r _dgw_d _dgw_via _dgw_g _dgw_dev _dgw_if _; do
			[ "$_dgw_d" = "default" ] || continue
			[ "$_dgw_via" = "via" ] || continue
			_dgw=$_dgw_g
			case "$_dgw_g" in
				fe80:*) [ "$_dgw_dev" = "dev" ] && _dgw="$_dgw_g%$_dgw_if" ;;
			esac
			break
		done <<EOF6
$(ip -6 route show default 2>/dev/null)
EOF6
	fi
	if [ -z "$_dgw" ] && command -v jsonfilter >/dev/null; then
		for _dgw_w6 in wan6 wan_6 wan; do
			_dgw_ifn6=$(ubus call network.interface."$_dgw_w6" status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
			_dgw_g=$(ubus call network.interface."$_dgw_w6" status 2>/dev/null | jsonfilter -e '@.route[0].nexthop' 2>/dev/null)
			case "$_dgw_g" in
				'') ;;
				fe80:*) _dgw="$_dgw_g${_dgw_ifn6:+%$_dgw_ifn6}"; break ;;
				*:*) _dgw=$_dgw_g; break ;;
			esac
		done
	fi
	printf '%s' "${_dgw:--}"
}

# The default route's gateway, from /proc/net/route's little-endian hex.
gateway4() {
	_dgw=""
	while read -r _dgw_rif _dgw_rdst _dgw_rgw _dgw_rflg _; do
		[ "$_dgw_rdst" = "00000000" ] || continue
		case "$_dgw_rgw" in *[!0-9A-Fa-f]*|"") continue ;; esac
		[ "$_dgw_rgw" = "00000000" ] && continue
		_dgw_b1=${_dgw_rgw#??????}
		_dgw_b2=${_dgw_rgw#????}; _dgw_b2=${_dgw_b2%??}
		_dgw_b3=${_dgw_rgw#??}; _dgw_b3=${_dgw_b3%????}
		_dgw_b4=${_dgw_rgw%??????}
		_dgw="$((0x$_dgw_b1)).$((0x$_dgw_b2)).$((0x$_dgw_b3)).$((0x$_dgw_b4))"
		break
	done < /proc/net/route
	printf '%s' "${_dgw:--}"
}

# Sets _family from dump entry $1's default route. Each target must equal
# "::" or "0.0.0.0" exactly: a 464xlat /128 host route can end in "::".
route_family() {
	_family=""
	_targets=$(printf '%s' "$_dump" | jsonfilter -e "@.interface[$1].route[*].target" 2>/dev/null)
	while IFS= read -r _rttgt; do
		case "$_rttgt" in
			::) _family="6"; break ;;
			0.0.0.0) _family="4"; break ;;
		esac
	done <<EOF
$_targets
EOF
}

# Sets _mark to mwan3's fwmark for device $1 and family $2, or "-".
mwan3_mark() {
	_mark=""
	if [ -f "$WRAP" ]; then
		_rules=""
		[ "$2" = "4" ] && _rules="$_rules4"
		[ "$2" = "6" ] && _rules="$_rules6"
		_table=$(printf '%s\n' "$_rules" | sed -n "/iif $1 /s/.*lookup //p" | head -1)
		[ -n "$_table" ] && _mark=$(printf '%s\n' "$_rules" | sed -n "/fwmark .*lookup $_table$/s/.*fwmark \(0x[0-9a-fA-F]*\).*/\1/p" | head -1)
	fi
	[ -z "$_mark" ] && _mark="-"
}

# Adds dump entry $1 (interface $2) when it holds a default route, as a line
# of: iface device srcip mark family target backup_target gateway. LAN is
# held back in _lan_deferred, since only an access point uses it.
scan_iface() {
	_i=$1; _ifn=$2
	case "$_ifn" in loopback) return ;; esac
	_is_lan=0
	case "$_ifn" in lan|lan6) _is_lan=1 ;; esac

	_up=""; _dev=""; _ip4=""; _ip6=""
	eval "$(printf '%s' "$_dump" | jsonfilter \
		-e "_up=@.interface[$_i].up" \
		-e "_dev=@.interface[$_i].l3_device" \
		-e "_ip4=@.interface[$_i][\"ipv4-address\"][0].address" 2>/dev/null)"
	_ip6_all=$(printf '%s' "$_dump" | jsonfilter -e "@.interface[$_i][\"ipv6-address\"][*].address" 2>/dev/null)
	for _a6 in $_ip6_all; do
		if is_public_ip6 "$_a6"; then
			_ip6="$_a6"
			break
		fi
	done

	[ "$_up" = "1" ] || [ "$_up" = "true" ] || return
	[ -z "$_dev" ] && return
	route_family "$_i"
	if [ "$_is_lan" = "1" ] && [ -n "$_ip4" ]; then
		_family="4"
	fi
	[ -z "$_family" ] && return

	_srcip=""
	[ "$_family" = "4" ] && _srcip="$_ip4"
	[ "$_family" = "6" ] && _srcip="$_ip6"
	mwan3_mark "$_dev" "$_family"
	_tgt=$(get_target_for_iface "$_ifn" "$_family" 0)
	_btgt=$(get_target_for_iface "$_ifn" "$_family" 1)
	# Only a LAN entry, which may become an AP uplink, needs its gateway.
	_gw="-"
	[ "$_is_lan" = "1" ] && _gw=$(discover_gateway "$_family")
	# The line is re-read with `read`, which collapses an empty field and
	# shifts the rest (a 464xlat clat has no address), so "-" stands in.
	_srcip=${_srcip:--}
	_line="$_ifn $_dev $_srcip $_mark $_family $_tgt $_btgt $_gw
"
	if [ "$_is_lan" = "1" ]; then
		_lan_deferred="$_lan_deferred$_line"
		_lan_names="$_lan_names $_ifn"
		_lan_gws="$_lan_gws$_ifn $_gw
"
		return
	fi
	IFACE_LIST="$IFACE_LIST$_line"
	_active="${_active}${_ifn}
"
	ACTIVE_IFACES="$ACTIVE_IFACES $_ifn"
}

# Access point: nothing but LAN holds a default route, so LAN is the uplink.
# .apmode lets the RPC title the card honestly; <iface>.gw hands it the
# gateway, which .gwstats has no field for.
promote_lan() {
	AP_MODE=0
	if [ -z "$ACTIVE_IFACES" ] && [ -n "$_lan_deferred" ]; then
		AP_MODE=1
		IFACE_LIST="$IFACE_LIST$_lan_deferred"
		for _ap_ifn in $_lan_names; do
			_active="${_active}${_ap_ifn}
"
			ACTIVE_IFACES="$ACTIVE_IFACES $_ap_ifn"
		done
		printf '%s' "$_lan_gws" | while read -r _pg_ifn _pg_gw; do
			[ -z "$_pg_ifn" ] && continue
			printf '%s\n' "$_pg_gw" > "$RINGDIR/${_pg_ifn}.gw"
		done
	fi
	if [ "$AP_MODE" = "1" ]; then
		printf '1\n' > "$RINGDIR/.apmode"
	else
		rm -f "$RINGDIR/.apmode" 2>/dev/null
	fi
}

# LAN stays tracked only on an access point, where it is the uplink.
keep_tracked() {
	case "$1" in
		loopback) return 1 ;;
		lan|lan6) [ "$AP_MODE" = "1" ] || return 1 ;;
	esac
	[ -z "$_uci_net" ] && return 0
	case "$_uci_net" in
		*"network.$1=interface"*) ;;
		*) return 1 ;;
	esac
	case "$_uci_net" in
		*"network.$1.disabled='1'"*) return 1 ;;
	esac
	return 0
}

# Ring files are "<iface>.*"; scratch buffers are ".probe.<iface>.*".
drop_iface_state() {
	rm -f "$RINGDIR/$1".* "$RINGDIR/.probe.$1".* 2>/dev/null
}

# Tracked WANs stay listed across ifdown so the outage shows, but one deleted
# or disabled in uci is dropped along with its ring state.
prune_tracked() {
	_old_tracked=""
	[ -f "$RINGDIR/.tracked" ] && _old_tracked=$(tr '\n' ' ' < "$RINGDIR/.tracked" 2>/dev/null)
	TRACKED_IFACES=""
	for _ifn in $_old_tracked; do
		if keep_tracked "$_ifn"; then
			TRACKED_IFACES="$TRACKED_IFACES $_ifn"
		else
			drop_iface_state "$_ifn"
		fi
	done
}

# uci device='@wan' says an interface rides a tracked WAN's link, so it is
# tracked too, even while it holds no default route of its own.
add_alias_ifaces() {
	_alias_pairs=$(printf '%s\n' "$_uci_net" | \
		sed -n "s/^network\.\([^.]*\)\.device='@\(.*\)'\$/\1 \2/p" 2>/dev/null)
	while read -r _a_child _a_parent; do
		[ -z "$_a_child" ] && continue
		[ -z "$_a_parent" ] && continue
		case " $TRACKED_IFACES " in *" $_a_parent "*) ;; *) continue ;; esac
		case " $TRACKED_IFACES " in *" $_a_child "*) continue ;; esac
		case "$_uci_net" in *"network.$_a_child.disabled='1'"*) continue ;; esac
		TRACKED_IFACES="$TRACKED_IFACES $_a_child"
	done <<EOF
$_alias_pairs
EOF
	printf '%s\n' "$_alias_pairs" > "$RINGDIR/.aliases"
}

# Sorted, so every reader lists the WANs in the same order whichever one
# netifd brought up first.
write_tracked() {
	printf '%s\n' "$TRACKED_IFACES" | tr ' ' '\n' | sed '/^$/d' | sort > "$RINGDIR/.tracked"
	mirror_tracked
}

discover_ifaces() {
	_dump=$(ubus call network.interface dump 2>/dev/null)
	# Bail before touching any state: clearing first made one ubus hiccup read
	# as every tracked WAN going down at once.
	[ -z "$_dump" ] && return
	IFACE_LIST=""
	_active=""
	ACTIVE_IFACES=""

	_rules4=""
	_rules6=""
	if [ -f "$WRAP" ]; then
		_rules4=$(ip -f inet rule 2>/dev/null)
		_rules6=$(ip -f inet6 rule 2>/dev/null)
	fi
	_names=$(printf '%s' "$_dump" | jsonfilter -e '@.interface[*].interface' 2>/dev/null)
	_lan_deferred=""
	_lan_names=""
	_lan_gws=""
	_idx=0
	for _ifn in $_names; do
		scan_iface "$_idx" "$_ifn"
		_idx=$((_idx + 1))
	done
	promote_lan
	# The collector's own live view; the RPC reads .tracked so an outage stays
	# on the card.
	ACTIVE_IFACES="${ACTIVE_IFACES# }"
	printf '%s' "$_active" > "$RINGDIR/.active"

	# One uci snapshot per discovery, shared by the prune and the alias scan.
	_uci_net=$(uci -q show network 2>/dev/null)
	prune_tracked
	# Actives go back in after the prune, so one with no uci section of its own
	# (made by a protocol handler) never drops off the card.
	for _ifn in $ACTIVE_IFACES; do
		case " $TRACKED_IFACES " in *" $_ifn "*) ;; *) TRACKED_IFACES="$TRACKED_IFACES $_ifn" ;; esac
	done
	add_alias_ifaces
	write_tracked
}

# Succeeds, stamping try file $1, once $2 seconds have passed since the last
# attempt.
isp_try_due() {
	if [ -f "$1" ]; then
		read -r _try_time < "$1" 2>/dev/null
		[ "$(( _now - ${_try_time:-0} ))" -lt "$2" ] && return 1
	fi
	printf '%d\n' "$_now" > "$1"
}

# Sets _org to AS $1's operator name, using scratch file $2.
lookup_org() {
	asn_txt "AS$1.asn.cymru.com" "$2"
	_org=$(asn_org "$2")
	rm -f "$2"
	_org=${_org# }
}

# Sets _asn from Cymru's origin zone for IPv4 address $1, using scratch file $2.
origin_asn4() {
	_o1=${1%%.*}; _r1=${1#*.}; _o2=${_r1%%.*}; _r2=${_r1#*.}; _o3=${_r2%%.*}; _o4=${_r2#*.}
	asn_txt "${_o4}.${_o3}.${_o2}.${_o1}.origin.asn.cymru.com" "$2"
	_asn=$(asn_pick "$2")
}

# With nothing routable to look up, or no answer, fall back on an interface
# name that names a known operator.
isp_from_name() {
	_lower_ifn=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
	case "$_lower_ifn" in
		*airtel*|*bharti*) _syn="AS24560 | Bharti Airtel Ltd." ;;
		*jio*|*reliance*)  _syn="AS55836 | Reliance Jio Infocomm" ;;
		*netplus*)         _syn="AS133661 | Netplus Broadband" ;;
		*bsnl*)            _syn="AS9829 | BSNL" ;;
		*railwire*|*railtel*) _syn="AS24186 | RailWire" ;;
		*hathway*)         _syn="AS17488 | Hathway Cable" ;;
		*vodafone*|*idea*) _syn="AS55410 | Vodafone Idea" ;;
		*comcast*|*xfinity*) _syn="AS7922 | Comcast" ;;
		*verizon*)         _syn="AS701 | Verizon" ;;
		*att*)             _syn="AS7018 | AT&T" ;;
		*)                 _syn="" ;;
	esac
	[ -n "$_syn" ] || return
	printf '%s' "$_syn" > "$RINGDIR/$1.isp"
	[ ! -f "$RINGDIR/${1}6.isp" ] && cp "$RINGDIR/$1.isp" "$RINGDIR/${1}6.isp" 2>/dev/null
}

# IPv6: the interface address is globally routed, so it is looked up directly,
# unless a v4 sibling already has the answer.
resolve_isp6() {
	_ifn=$1; _srcip=$2
	_isp_file="$RINGDIR/${_ifn}.isp"
	case "$_ifn" in
		*6)
			_base=${_ifn%6}
			if [ -f "$RINGDIR/${_base}.isp" ]; then
				cp "$RINGDIR/${_base}.isp" "$_isp_file" 2>/dev/null
				return
			fi
			;;
	esac
	[ -f "$_isp_file" ] && return
	is_public_ip6 "$_srcip" || return
	_try_file="$RINGDIR/${_ifn}.isp.try"
	isp_try_due "$_try_file" "$ISP_RETRY_INTERVAL" || return
	_rev6=$(ip6_nibbles "$_srcip")
	[ -z "$_rev6" ] && return
	_nsf="$RINGDIR/.probe.${_ifn}.ns"
	asn_txt "${_rev6}.origin6.asn.cymru.com" "$_nsf"
	_asn=$(asn_pick "$_nsf")
	case "$_asn" in ''|*[!0-9]*) rm -f "$_nsf"; return ;; esac
	lookup_org "$_asn" "$_nsf"
	[ -z "$_org" ] && return
	printf 'AS%s | %s' "$_asn" "$_org" > "$_isp_file"
	_base=${_ifn%6}
	[ -n "$_base" ] && [ ! -f "$RINGDIR/${_base}.isp" ] && cp "$_isp_file" "$RINGDIR/${_base}.isp" 2>/dev/null
	rm -f "$_try_file"
}

# IPv4: the public exit address is the ground truth. Failing that the gateway
# stands in, never the interface address, since a CGNAT operator may number
# its side from someone else's space. A stand-in writes no .pubip, so the exit
# address keeps being retried.
resolve_isp4() {
	_dev=$1; _srcip=$2; _mark=$3; _ifn=$4
	_isp_file="$RINGDIR/${_ifn}.isp"
	_ip_file="$RINGDIR/${_ifn}.ispip"
	_last_ip=""
	[ -f "$_ip_file" ] && read -r _last_ip < "$_ip_file" 2>/dev/null
	if [ ! -f "$_isp_file" ] && [ -f "$RINGDIR/${_ifn}6.isp" ]; then
		cp "$RINGDIR/${_ifn}6.isp" "$_isp_file" 2>/dev/null
	fi
	if [ -f "$_isp_file" ] && [ "$_last_ip" = "$_srcip" ] && [ -f "$RINGDIR/${_ifn}.pubip" ]; then
		return
	fi
	_try_file="$RINGDIR/${_ifn}.isp.try"
	# A stand-in answer is already on screen, so it is re-checked less often.
	_iv=$ISP_RETRY_INTERVAL
	[ -f "$_isp_file" ] && _iv=300
	isp_try_due "$_try_file" "$_iv" || return
	_nsf="$RINGDIR/.probe.${_ifn}.ns"
	_pub=$(get_public_ip4 "$_dev" "$_srcip" "$_mark" "$_ifn")
	is_public_ip4 "$_pub" || _pub=""
	_lookup=$_pub
	if [ -z "$_lookup" ]; then
		_gw=$(iface_gateway4 "$_ifn" "$_dev")
		is_public_ip4 "$_gw" && _lookup=$_gw
	fi
	_asn=""
	[ -n "$_lookup" ] && origin_asn4 "$_lookup" "$_nsf"
	if [ -z "$_asn" ]; then
		isp_from_name "$_ifn"
		rm -f "$_nsf"
		return
	fi
	lookup_org "$_asn" "$_nsf"
	[ -z "$_org" ] && return
	printf 'AS%s | %s' "$_asn" "$_org" > "$_isp_file"
	[ ! -f "$RINGDIR/${_ifn}6.isp" ] && cp "$_isp_file" "$RINGDIR/${_ifn}6.isp" 2>/dev/null
	printf '%s' "$_srcip" > "$_ip_file"
	if [ -n "$_pub" ]; then
		printf '%s' "$_pub" > "$RINGDIR/${_ifn}.pubip"
		rm -f "$_try_file"
	else
		rm -f "$RINGDIR/${_ifn}.pubip"
	fi
}

resolve_isp() {
	_dev=$1; _srcip=$2; _mark=$3; _ifn=$4; _family=$5
	if [ "$_family" = "6" ]; then
		resolve_isp6 "$_ifn" "$_srcip"
	else
		resolve_isp4 "$_dev" "$_srcip" "$_mark" "$_ifn"
	fi
}

# Adds one sample to the rolling 24 h window. Reusing a bucket slot first
# subtracts its expired counts, so rpcd reads one small summary file.
record_window_sample() {
	_ifn=$1; _ok=$2; _pfx=${3:-}
	_bucket=$((_now / WINDOW_BUCKET_SECS))
	_slot=$((_bucket % WINDOW_BUCKETS))
	_bucket_file="$RINGDIR/${_ifn}.${_pfx}day.${_slot}"
	_summary_file="$RINGDIR/${_ifn}.${_pfx}daystats"
	_old_bucket=""; _old_total=0; _old_success=0
	[ -f "$_bucket_file" ] && read -r _old_bucket _old_total _old_success < "$_bucket_file" 2>/dev/null
	_total=0; _success=0
	[ -f "$_summary_file" ] && read -r _total _success < "$_summary_file" 2>/dev/null
	if [ "$_old_bucket" != "$_bucket" ]; then
		_total=$((_total - ${_old_total:-0}))
		_success=$((_success - ${_old_success:-0}))
		[ "$_total" -lt 0 ] && _total=0
		[ "$_success" -lt 0 ] && _success=0
		_old_total=0; _old_success=0
	fi
	_old_total=$((_old_total + 1))
	[ "$_ok" = "1" ] && _old_success=$((_old_success + 1))
	_total=$((_total + 1))
	[ "$_ok" = "1" ] && _success=$((_success + 1))
	printf '%s %d %d\n' "$_bucket" "$_old_total" "$_old_success" > "$_bucket_file"
	printf '%d %d\n' "$_total" "$_success" > "$_summary_file"
}

# Records each up/down transition in syslog, so it is kept even with no
# dashboard open.
log_transition() {
	_lt_ifn=$1; _lt_new=$2; _lt_reason=$3
	command -v logger >/dev/null 2>&1 || return
	if [ "$_lt_new" = "down" ]; then
		logger -t hwdash -p daemon.warn \
			"WAN $_lt_ifn is DOWN${_lt_reason:+ -- $_lt_reason}"
	else
		logger -t hwdash -p daemon.notice "WAN $_lt_ifn is UP"
	fi
}

# Throughput from the kernel byte counters, with builtin reads only. The
# counters reset whenever the device is recreated (every PPPoE reconnect), so
# a negative delta restarts the measurement rather than reading as a spike.
sample_rate() {
	_rt_ifn=$1; _rt_dev=$2
	_rt_file="$RINGDIR/${_rt_ifn}.rate"
	[ -n "$_rt_dev" ] || return
	_rt_rx=""; _rt_tx=""
	read -r _rt_rx < "/sys/class/net/$_rt_dev/statistics/rx_bytes" 2>/dev/null || return
	read -r _rt_tx < "/sys/class/net/$_rt_dev/statistics/tx_bytes" 2>/dev/null || return
	case "$_rt_rx$_rt_tx" in ''|*[!0-9]*) return ;; esac
	_pr=0; _pt=0; _pw=0
	[ -f "$_rt_file" ] && read -r _pr _pt _pw _ < "$_rt_file" 2>/dev/null
	case "$_pr" in ''|*[!0-9]*) _pr=0 ;; esac
	case "$_pt" in ''|*[!0-9]*) _pt=0 ;; esac
	case "$_pw" in ''|*[!0-9]*) _pw=0 ;; esac
	_rt_dt=$((_now - _pw))
	_rt_rbps=0; _rt_tbps=0
	if [ "$_pw" -gt 0 ] && [ "$_rt_dt" -gt 0 ] && \
	   [ "$_rt_rx" -ge "$_pr" ] && [ "$_rt_tx" -ge "$_pt" ]; then
		_rt_rbps=$(( (_rt_rx - _pr) / _rt_dt ))
		_rt_tbps=$(( (_rt_tx - _pt) / _rt_dt ))
	fi
	# Device name last: interfaces sharing a device (a v4/v6 pair, an alias)
	# must not be read as two independent flows.
	printf '%s %s %s %s %s %s\n' "$_rt_rx" "$_rt_tx" "$_now" "$_rt_rbps" "$_rt_tbps" "$_rt_dev" > "$_rt_file"
}

# Stats file: total success status streak_start lastgood_ms consecutive_misses.
# lastgood_ms stays "x" until the link has answered once, so the card never
# shows a made-up latency.
load_stats() {
	_total=0; _success=0; _status="unknown"; _streak_start=$_now
	_lastgood_ms="x"; _consec_miss=0
	[ -f "$1" ] && read -r _total _success _status _streak_start _lastgood_ms _consec_miss < "$1" 2>/dev/null
	case "$_lastgood_ms" in ''|*[!0-9]*) _lastgood_ms="x" ;; esac
	case "$_consec_miss" in ''|*[!0-9]*) _consec_miss=0 ;; esac
}

save_stats() {
	printf '%d %d %s %d %s %d\n' \
		"$_total" "$_success" "$_status" "$_streak_start" \
		"$_lastgood_ms" "$_consec_miss" > "$1"
}

# Sets _ms to the whole-millisecond RTT in ping output $1, or empty.
parse_ms() {
	_ms=""
	case "$1" in
		*time=*)
			_ms=${1#*time=}
			_ms=${_ms%% *}
			_ms=${_ms%%.*}
			case "$_ms" in ''|*[!0-9]*) _ms="" ;; esac
			;;
	esac
}

# Folds one probe result ($3 = ms, empty on a miss) into interface $1's
# "${2}stats" file and 24 h window. A miss on an up link still counts as up
# until MISS_THRESHOLD in a row; one still "unknown" has nothing to carry
# forward. $4 explains a down transition in the log. Sets _status.
record_probe() {
	_rec_ifn=$1; _rec_pfx=$2; _rec_ms=$3; _rec_why=$4
	_rec_file="$RINGDIR/${_rec_ifn}.${_rec_pfx}stats"
	load_stats "$_rec_file"
	_total=$((_total + 1))
	if [ -n "$_rec_ms" ]; then
		_success=$((_success + 1))
		_new_status="up"
		_lastgood_ms="$_rec_ms"
		_consec_miss=0
		_sample_up=1
	else
		_consec_miss=$((_consec_miss + 1))
		if [ "$_consec_miss" -lt "$MISS_THRESHOLD" ] && [ "$_status" = "up" ]; then
			_success=$((_success + 1))
			_new_status="up"
			_sample_up=1
		else
			_new_status="down"
			_sample_up=0
		fi
	fi
	if [ "$_new_status" != "$_status" ]; then
		# Leaving "unknown" after a restart is not a network event.
		case "$_status" in
			up|down) log_transition "$_rec_ifn" "$_new_status" "$_rec_why" ;;
		esac
		_status="$_new_status"
		_streak_start=$_now
	fi
	save_stats "$_rec_file"
	record_window_sample "$_rec_ifn" "$_sample_up" "$_rec_pfx"
}

# netifd still has the link up with a route; the probes are just not coming
# back, so the reason is already known and needs no ubus call.
set_unreachable_reason() {
	if [ "$_status" = "down" ]; then
		printf '%d unreachable %s\n' "$_now" "$2" > "$1"
	elif [ -f "$1" ]; then
		rm -f "$1" 2>/dev/null
	fi
}

# An AP uplink measured against the upstream router, in its own .gwstats so
# the interface's internet-ping history keeps its meaning. No backup target:
# a single upstream hop either answers or is unreachable.
process_ap_gateway() {
	_ifn=$1; _dev=$2; _srcip=$3; _mark=$4; _family=$5; _gw=$6
	_ms=""
	[ -n "$_srcip" ] && parse_ms "$(do_ping "$_dev" "$_srcip" "$_mark" "$_family" "$_gw" "$_ifn")"
	_why="Gateway $_gw is not responding to ping from interface $_dev."
	record_probe "$_ifn" gw "$_ms" "$_why"
	set_unreachable_reason "$RINGDIR/${_ifn}.gwreason" "$_why"
}

# One interface's tick: probe, update stats and the 24 h window, sample the
# rate, resolve the ISP. Each runs in the background so one slow link cannot
# stall the rest.
process_iface() {
	_ifn=$1; _dev=$2; _srcip=$3; _mark=$4; _family=$5; _tgt=$6; _btgt=$7; _gw=$8
	[ -n "$_gw" ] && [ "$_gw" != "-" ] && process_ap_gateway "$_ifn" "$_dev" "$_srcip" "$_mark" "$_family" "$_gw"
	# Gated on the device, not the address: a 464xlat clat device has no
	# address over ubus, yet answers when bound by device.
	_out=""
	[ -n "$_dev" ] && _out=$(ping_with_backup "$_dev" "$_srcip" "$_mark" "$_family" "$_ifn" "$_tgt" "$_btgt")
	parse_ms "$_out"
	_why="The interface $_dev reports a carrier, but the probe target ${_tgt:-the ICMP host} did not respond."
	record_probe "$_ifn" "" "$_ms" "$_why"
	sample_rate "$_ifn" "$_dev"
	set_unreachable_reason "$RINGDIR/${_ifn}.reason" "$_why"
	resolve_isp "$_dev" "$_srcip" "$_mark" "$_ifn" "$_family"
}

# Kernel carrier on either netifd name, since either may not be a real netdev
# (a uci bridge name; a ppp device that is gone while down). An admin-down
# device returns EINVAL here, so only an explicit 0 counts as unplugged.
no_carrier_reason() {
	for _r_nd in "$_r_dev" "$_r_l3"; do
		[ -n "$_r_nd" ] || continue
		[ -f "/sys/class/net/$_r_nd/carrier" ] || continue
		_r_car=""
		read -r _r_car < "/sys/class/net/$_r_nd/carrier" 2>/dev/null
		if [ "$_r_car" = "0" ]; then
			echo "nocarrier The physical link on interface $_r_nd is down. The cable is disconnected, or the upstream device is powered off."
			return 0
		fi
		break
	done
	return 1
}

# The codes netifd core and the stock protocol handlers emit (ubus.c, ppp.sh's
# exit codes, dhcp and modem handlers); anything else is reported verbatim.
netifd_error_reason() {
	case "$1" in
		NO_DEVICE|NO_IFACE|NO_IFNAME|BAD_DEVICE)
		                  echo "netifd The configured physical or logical device is missing." ;;
		DEVICE_CLAIM_FAILED)
		                  echo "netifd The device could not be claimed. Another interface is currently using it." ;;
		NO_ADDRESS|ADDRESS_MISSING|NO_IPADDRESS)
		                  echo "netifd No IP address was received from the upstream gateway or server." ;;
		PREFIX_MISSING)   echo "netifd The service provider did not delegate an IPv6 prefix." ;;
		PEER_AUTH_FAILED|CNID_AUTH_FAILED|AUTH_FAILED)
		                  echo "netifd PPP authentication failed. The service provider rejected the credentials." ;;
		AUTH_TOPEER_FAILED)
		                  echo "netifd Upstream service provider authentication failed." ;;
		CONNECT_FAILED|CALL_FAILED)
		                  echo "netifd The attempt to establish a connection to the service provider failed." ;;
		NEGOTIATION_FAILED)
		                  echo "netifd PPP session negotiation with the service provider failed." ;;
		PEER_DEAD|HANGUP) echo "netifd The service provider terminated the active PPP session." ;;
		IDLE_TIMEOUT)     echo "netifd The PPP session was closed after an inactivity timeout." ;;
		TRAFFIC_LIMIT)    echo "netifd The PPP session reached its configured data traffic limit." ;;
		INVALID_ADDRESS|INVALID_GATEWAY|INVALID_NETMASK|INVALID_BROADCAST|INVALID_PTPADDR)
		                  echo "netifd Invalid addressing information was received from the upstream service provider." ;;
		OPTION_ERROR|INVALID_PROTO|INVALID_OPTIONS)
		                  echo "netifd Interface configuration parameters were rejected." ;;
		SETUP_FAILED|CONFIGURE_FAILED|INITIALIZE_FAILED)
		                  echo "netifd Interface initialisation failed." ;;
		NO_APN|NO_REGISTRATION|NETWORK_REGISTRATION_FAILED)
		                  echo "netifd Cellular network registration failed." ;;
		PIN_FAILED|PIN_NOT_SPECIFIED|MM_PINCODE_REQUIRED|MM_PINCODE_WRONG|PUK_NEEDED)
		                  echo "netifd The SIM card is locked. A valid PIN or PUK code is required." ;;
		*)                echo "netifd netifd reported the error code $1." ;;
	esac
}

# Up but unaddressed, explained by protocol $1.
no_address_reason() {
	case "$1" in
		dhcp|dhcpv6)
			echo "nolease No DHCP lease was acquired. The upstream server did not respond, or the lease has expired." ;;
		pppoe|pppoa|ppp|l2tp|pptp)
			case "$1" in
				pppoe) _r_pname="PPPoE" ;;
				pppoa) _r_pname="PPPoA" ;;
				ppp)   _r_pname="PPP" ;;
				l2tp)  _r_pname="L2TP" ;;
				pptp)  _r_pname="PPTP" ;;
			esac
			echo "nosession The $_r_pname session is not established." ;;
		static)
			echo "noaddress The configured static IP address is not assigned to the interface." ;;
		*)
			echo "noaddress The link is up, but no IP address was assigned." ;;
	esac
}

# Why netifd has interface $1 down, as "<code> <text>". Physical causes come
# first: with no carrier there is nothing to run DHCP over, so a missing
# lease would name the symptom and hide the cause.
wan_down_reason() {
	_r_st=$(ubus call "network.interface.$1" status 2>/dev/null)
	if [ -z "$_r_st" ]; then
		echo "missing The interface is no longer managed by netifd. It may have been deleted or renamed."
		return
	fi
	_r_up=""; _r_avail=""; _r_auto=""; _r_dev=""; _r_l3=""; _r_proto=""; _r_pending=""
	_r_v4=""; _r_v6=""
	eval "$(printf '%s' "$_r_st" | jsonfilter \
		-e '_r_up=@.up' -e '_r_avail=@.available' -e '_r_auto=@.autostart' \
		-e '_r_dev=@.device' -e '_r_l3=@.l3_device' \
		-e '_r_proto=@.proto' -e '_r_pending=@.pending' \
		-e '_r_v4=@["ipv4-address"][0].address' \
		-e '_r_v6=@["ipv6-address"][0].address' 2>/dev/null)" 2>/dev/null

	no_carrier_reason && return
	case "$_r_auto" in
		0|false) echo "admin The interface is administratively disabled and configured not to start automatically."; return ;;
	esac
	case "$_r_avail" in
		0|false) echo "nodevice The physical device${_r_dev:+ ($_r_dev)} is not present. The port or hardware module is missing."; return ;;
	esac
	_r_err=$(printf '%s' "$_r_st" | jsonfilter -e '@.errors[0].code' 2>/dev/null)
	if [ -n "$_r_err" ]; then
		netifd_error_reason "$_r_err"
		return
	fi
	case "$_r_pending" in
		1|true) echo "pending The connection is currently being negotiated." ; return ;;
	esac
	if [ "$_r_up" = "1" ] || [ "$_r_up" = "true" ]; then
		if [ -z "$_r_v4" ] && [ -z "$_r_v6" ]; then
			no_address_reason "$_r_proto"
		else
			# Up and addressed, but discovery skipped it: no default route.
			echo "noroute The interface is up with an assigned IP address, but no default route is provided by the upstream gateway."
		fi
		return
	fi
	echo "stopped The interface has been stopped by the network configuration daemon."
}

# One forced outage sample in $1's .stats. Sets _went_down when this sample
# takes the link from up to down.
mark_iface_down() {
	_sf="$RINGDIR/$1.stats"
	load_stats "$_sf"
	_total=$((_total + 1))
	_was_status=$_status
	_consec_miss=$((_consec_miss + 1))
	if [ "$_consec_miss" -lt 2 ] && [ "$_status" = "up" ]; then
		_new_status="up"
	else
		_new_status="down"
		if [ "$_status" != "down" ]; then
			_streak_start=$_now
		fi
	fi
	_status="$_new_status"
	save_stats "$_sf"
	record_window_sample "$1" 0
	_went_down=0
	[ "$_was_status" = "up" ] && [ "$_status" = "down" ] && _went_down=1
}

# An AP uplink's gateway stream goes down with it. No .gwreason: .reason
# already carries netifd's diagnosis for both streams.
mark_gateway_down() {
	_sf="$RINGDIR/$1.gwstats"
	load_stats "$_sf"
	_total=$((_total + 1))
	if [ "$_status" != "down" ]; then
		_status="down"
		_streak_start=$_now
	fi
	_consec_miss=$MISS_THRESHOLD
	save_stats "$_sf"
	record_window_sample "$1" 0 "gw"
}

# Re-reads netifd's view on the transition, then every REASON_INTERVAL. Two
# "missing" answers in a row mean the interface was deleted (one alone is
# just a netifd restart); a .gone marker is left for the main loop, the only
# writer of .tracked.
refresh_down_reason() {
	_reason_file="$RINGDIR/$1.reason"
	_r_at=0; _r_rest=""
	[ -f "$_reason_file" ] && read -r _r_at _r_rest < "$_reason_file" 2>/dev/null
	case "$_r_at" in ''|*[!0-9]*) _r_at=0 ;; esac
	_r_old_code=${_r_rest%% *}
	if [ -z "$_r_rest" ] || [ $((_now - _r_at)) -ge "$REASON_INTERVAL" ]; then
		_r_new=$(wan_down_reason "$1")
		printf '%d %s\n' "$_now" "$_r_new" > "$_reason_file"
		case "${_r_new%% *}:$_r_old_code" in
			missing:missing) : > "$RINGDIR/.gone.$1" ;;
		esac
	fi
}

# netifd has taken the interface down, so there is no route to probe over:
# record an outage sample. The next ifup discovery resumes probing.
process_down_iface() {
	_ifn=$1
	mark_iface_down "$_ifn"
	[ -f "$RINGDIR/${_ifn}.gwstats" ] && mark_gateway_down "$_ifn"
	# Zero the timestamp too: sample_rate then restarts from the next tick
	# instead of reading lifetime bytes as one interval's traffic.
	printf '0 0 0 0 0 -\n' > "$RINGDIR/${_ifn}.rate"
	refresh_down_reason "$_ifn"
	# Logged after the reason is known, so the syslog line carries the cause.
	if [ "$_went_down" = "1" ]; then
		_lg_text=""
		read -r _ _ _lg_text < "$RINGDIR/${_ifn}.reason" 2>/dev/null
		log_transition "$_ifn" down "$_lg_text"
	fi
}

# rpcd relays the raw probe targets here whenever Settings is read or saved.
# Version-gated so a file from an older rpcd is not read as "targets cleared".
# Succeeds when the targets changed.
poll_wan_targets() {
	[ -f "$RINGDIR/.wan_targets" ] || return 1
	WANTGT_V=""; WANTGT4=""; WANTGT6=""
	. "$RINGDIR/.wan_targets" 2>/dev/null
	[ "$WANTGT_V" = "2" ] && apply_targets "$WANTGT4" "$WANTGT6"
}

poll_persist_dir() {
	[ -f "$RINGDIR/.persist_dir" ] || return
	PERSISTDIR_V=""; PERSISTDIR=""
	. "$RINGDIR/.persist_dir" 2>/dev/null
	[ "$PERSISTDIR_V" != "1" ] && PERSISTDIR=""
}

probe_active_ifaces() {
	[ -n "$IFACE_LIST" ] || return
	while read -r _ifn _dev _srcip _mark _family _tgt _btgt _gw; do
		[ -z "$_ifn" ] && continue
		[ "$_srcip" = "-" ] && _srcip=""
		process_iface "$_ifn" "$_dev" "$_srcip" "$_mark" "$_family" "$_tgt" "$_btgt" "$_gw" &
		_pids="$_pids $!"
	done <<EOF
$IFACE_LIST
EOF
}

# Drops interfaces process_down_iface found deleted, without waiting for the
# next rediscovery. Only the main loop rewrites .tracked, so the parallel
# per-interface jobs never race on it.
drop_gone_ifaces() {
	_gone=""
	for _gf in "$RINGDIR"/.gone.*; do
		[ -e "$_gf" ] || continue
		_gone="$_gone ${_gf##*/.gone.}"
		rm -f "$_gf"
	done
	[ -n "$_gone" ] || return
	_new_tracked=""
	for _ifn in $TRACKED_IFACES; do
		case " $_gone " in
			*" $_ifn "*) drop_iface_state "$_ifn" ;;
			*) _new_tracked="$_new_tracked $_ifn" ;;
		esac
	done
	TRACKED_IFACES=$_new_tracked
	write_tracked
}

# Tracked but without a default route: kept on the card as Offline, with one
# outage sample per tick.
probe_down_ifaces() {
	for _ifn in $TRACKED_IFACES; do
		case " $ACTIVE_IFACES " in *" $_ifn "*) continue ;; esac
		process_down_iface "$_ifn" &
		_pids="$_pids $!"
	done
}

detect_asn_dns
mkdir -p "$RINGDIR"
load_persist_dir
seed_tracked
seed_wan_history
load_targets

while :; do
	# Monotonic uptime, not epoch: a router without an RTC jumps its clock at
	# NTP sync, which would corrupt streak starts and bucket indexes.
	read -r _now _ < /proc/uptime
	_now=${_now%%.*}
	_force_discover=0
	poll_wan_targets && _force_discover=1
	if [ -f "$RINGDIR/.rediscover" ]; then
		rm -f "$RINGDIR/.rediscover"
		_force_discover=1
	fi
	if [ "$_force_discover" = "1" ] || [ -z "$IFACE_LIST" ] || [ $((_now - LAST_DISCOVER)) -ge "$DISCOVER_INTERVAL" ]; then
		discover_ifaces
		LAST_DISCOVER=$_now
	fi
	poll_persist_dir
	if [ -n "$PERSISTDIR" ] && [ $((_now - LAST_PERSIST_SYNC)) -ge "$PERSIST_SYNC_INTERVAL" ]; then
		sync_wan_history
		LAST_PERSIST_SYNC=$_now
	fi
	_pids=""
	probe_active_ifaces
	drop_gone_ifaces
	probe_down_ifaces
	if [ -n "$_pids" ]; then
		wait $_pids 2>/dev/null
	fi
	sleep "$INTERVAL"
done

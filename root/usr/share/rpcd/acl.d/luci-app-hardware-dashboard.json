{
	"luci-app-hardware-dashboard": {
		"description": "Grant access to Hardware Dashboard",
		"read": {
			"ubus": {
				"luci.hwdash": [ "info" ],
				"luci.hwdash.ping": [ "ping" ],
				"luci.hwdash.wan": [ "wan_quality", "ap_stats" ],
				"luci.hwdash.wanip": [ "wan_ips" ],
				"luci.hwdash.wifi": [ "wifi_clients" ],
				"luci.hwdash.ctl": [ "get_config", "nat_test", "pkg_status" ]
			},
			"file": {
				"/proc/stat": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"luci.hwdash.ctl": [ "set_config", "nat_test", "pkg_action" ]
			}
		}
	}
}

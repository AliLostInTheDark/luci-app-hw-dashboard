{
	"luci-app-hardware-dashboard": {
		"description": "Grant access to Hardware Dashboard",
		"read": {
			"ubus": {
				"luci.hwdash": [ "info", "ping", "wan_quality", "get_config", "get_cpu_perf", "get_aql", "wifi_clients", "wan_ips" ]
			},
			"cgi-io": [ "exec" ]
		},
		"write": {
			"ubus": {
				"luci.hwdash": [ "set_config", "set_cpu_perf", "set_aql", "nat_test" ]
			}
		}
	}
}
